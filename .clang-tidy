# Static analysis for shared/, the pure-C core.
#
# The check list is curated: the analyser, the bug-shaped checks, and the
# portability checks that matter to code compiled by three toolchains for two
# architectures.
#
# What is off, and why:
#
#   readability-magic-numbers        this is a rasteriser and a register map;
#                                    the numbers are the specification
#   readability-identifier-length    i, x, y, c are the right names here
#   readability-braces-around-*      the house style already always braces
#   readability-function-cognitive-complexity
#                                    render paths are long and flat by nature;
#                                    frame_cost.py is the real budget
#   bugprone-easily-swappable-parameters
#                                    fires on every (x, y) and (w, h) pair
#   misc-no-recursion                the decoders are recursive by design
#   cert-err33-c                     snprintf's return is ignored where the
#                                    buffer is sized by construction
#   *-avoid-magic-numbers            same as above
#   clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#                                    it wants snprintf_s, a C11 Annex K
#                                    function neither glibc nor newlib
#                                    implements; snprintf with a size is the
#                                    bounded call, and the check fires on
#                                    every one of them
#   clang-analyzer-optin.performance.Padding
#                                    struct field order for padding is a
#                                    micro-optimisation, not a defect
#   portability-avoid-pragma-once    exists from LLVM 21.  The tree uses both
#                                    guards: 40 headers under shared/ use
#                                    #pragma once and 18 use #ifndef, nine of
#                                    those in shared/link.  #pragma once is
#                                    supported by all three toolchains (GCC,
#                                    ESP-IDF's GCC, ARM GCC), so the ones
#                                    that use it are not a portability
#                                    problem here.  Off so clang-tidy 18 (CI) and
#                                    newer versions give the same answer
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  portability-*,
  performance-*,
  misc-*,
  readability-const-return-type,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-non-const-parameter,
  readability-redundant-control-flow,
  readability-redundant-declaration,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -misc-no-recursion,
  -misc-include-cleaner,
  -cert-err33-c,
  -*-avoid-magic-numbers,
  -readability-function-cognitive-complexity,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-optin.performance.Padding,
  -portability-avoid-pragma-once

WarningsAsErrors: '*'
HeaderFilterRegex: 'shared/.*\.h$'
FormatStyle: none
