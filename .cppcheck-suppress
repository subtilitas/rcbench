# cppcheck suppressions, each with the reason it is not a bug here.

# Functions in the public API (application programming interface) land with
# their tests before the screen that calls them exists.  An unused public
# function is an open item in STATUS.md, not a defect.
unusedFunction

# cppcheck cannot see the three build systems, so every header looks like it
# has an unused include from the one translation unit it is scanning.
missingIncludeSystem
unmatchedSuppression

# Page callbacks in the link tests take the registered void *ctx of
# link_page_t.  Most test pages ignore it; the type of the member is not
# const, so a const parameter would need a cast at every table entry.
constParameterCallback:test/host/test_link_loopback.c
constParameterCallback:test/host/test_link_pages.c
