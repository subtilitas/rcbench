# SPDX-License-Identifier: MIT
#
# Doxygen configuration for the C sources: the API (application programming
# interface) reference that GitHub Pages publishes under api/.  Settings not
# named here keep Doxygen's defaults.  CI (continuous integration) runs
# Doxygen 1.18.0 through tools/doc_check.py, which reads the warnings and
# decides; Doxygen itself never fails the build.
#
#   python3 tools/doc_check.py --check    # the gate CI runs
#   mkdir -p build/doxygen && doxygen     # the HTML alone, into build/doxygen
#                                         # (Doxygen creates one directory
#                                         # level, not two)

PROJECT_NAME           = rcbench
PROJECT_BRIEF          = "Servo and ESC test bench: panel, IOmcu and shared C"
OUTPUT_DIRECTORY       = build/doxygen

# --- Input -----------------------------------------------------------------
# The panel and IOmcu firmware, the shared core, the protocol modules (their
# include/ headers, core C files and rp2350/ pin drivers) and the touch
# injector's core.  Generated tables (fonts, the ESC profile tables, the
# board drawings) are the generators' and are left out, as are build trees,
# the ESP component registry's managed_components and the host suite.
INPUT                  = shared \
                         protocols \
                         firmware/panel \
                         firmware/iomcu \
                         testbench/touch-injector/core
FILE_PATTERNS          = *.c *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */gfx_font* \
                         *_gen.c \
                         */board_drawing_* \
                         */managed_components/* \
                         */build/* \
                         */build-*/* \
                         */iomcu-image/* \
                         */test/host/*
FULL_PATH_NAMES        = YES
# Attributes are read as nothing, so a function with one keeps its name.
# The build flags are set as the firmware builds set them, with every
# optional part on, so code behind #if and #ifdef is read and checked:
# the panel (ESP_PLATFORM, RCBENCH_TOUCH_INJECTOR, RCBENCH_IOMCU_IMAGE,
# RCBENCH_DISPLAY_BARS, exFAT, an 8192-byte main task), the IOmcu's
# trace, console and sense bring-up, and the text trace of gfx.
# Not set: WA_PAGE_DE (test_wa_page_de's stand-in), GFX_INL_FORCE (gfx.c
# defines it), OUT_PPM_MAX_PINS and OUT_DSHOT_MAX_PINS (their #ifndef
# default is the definition to read), ESP_IDF_VERSION and
# CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM (#error guards only), and the
# include guards.  ESP_PLATFORM hides the host-only code under
# #ifndef ESP_PLATFORM: k_names in shared/ui/ui_text.c.
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "__attribute__(x)=" \
                         IRAM_ATTR= \
                         ESP_PLATFORM=1 \
                         RCBENCH_TOUCH_INJECTOR=1 \
                         RCBENCH_IOMCU_IMAGE=1 \
                         RCBENCH_DISPLAY_BARS=1 \
                         FF_FS_EXFAT=1 \
                         CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192 \
                         SENSE_TRACE=1 \
                         IOMCU_CONSOLE=1 \
                         IOMCU_SENSE_BRINGUP=1 \
                         GFX_TEXT_TRACE=1
OPTIMIZE_OUTPUT_FOR_C  = YES

# --- What counts as documented ---------------------------------------------
# A brief is an explicit @brief; the first sentence of a block is not one.
JAVADOC_AUTOBRIEF      = NO
# An item without a comment is left out of the HTML and warned about.
EXTRACT_ALL            = NO
# Static helpers in .c files are held to a @brief as well.
EXTRACT_STATIC         = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
# tools/doc_check.py compares the warnings with tools/doc_check_baseline.txt
# and fails on a new one; Doxygen's own exit code stays 0.
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"
# A plain doxygen run writes its warnings here rather than to the
# terminal; tools/doc_check.py names its own log.
WARN_LOGFILE           = build/doxygen/warnings.log
QUIET                  = YES

# --- Output -----------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
HAVE_DOT               = NO
