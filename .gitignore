# Build trees -------------------------------------------------------------
# build-san and build-tidy are the sanitizer and analysis trees the CI
# commands in CONTRIBUTING.md create.
build/
*/build/
build-*/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
# The panel's lock file pins the managed components of its Wi-Fi
# (firmware/panel/components/wifi_access/idf_component.yml) and is kept.
!firmware/panel/dependencies.lock
# And the C6 radio's (tools/c6_image.py); its project is a copy made at
# build time.
!firmware/c6/dependencies.lock
firmware/c6/slave/

# Host suite and coverage -------------------------------------------------
test/host/build/
*.gcda
*.gcno
*.gcov
coverage.json
cachegrind.out.*

# Editors and platforms ---------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Python ------------------------------------------------------------------
__pycache__/
*.pyc
.pytest_cache/
