{
  "name": "rcbench-configurator",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node drawings/cli.ts --check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\" \"drawings/test/*.test.ts\"",
    "drawings": "node drawings/cli.ts",
    "drawings:check": "node drawings/cli.ts --check",
    "e2e": "playwright test",
    "size": "node tools/size.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
