{
 "defs": {
  "str": {
   "type": "string"
  },
  "strs": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "requirement": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string"
    },
    "required": {
     "type": "string",
     "description": "value and unit the specification or an answer fixes"
    },
    "datasheet": {
     "type": "string",
     "description": "the datasheet's value and unit, with its table or page"
    },
    "pass": {
     "type": "boolean"
    },
    "source": {
     "type": "string"
    }
   },
   "required": [
    "name",
    "required",
    "datasheet",
    "pass",
    "source"
   ]
  },
  "candidate": {
   "type": "object",
   "properties": {
    "rank": {
     "type": "integer"
    },
    "part": {
     "type": "string"
    },
    "maker": {
     "type": "string",
     "description": "from the datasheet; the allowlist name it counts as"
    },
    "lcsc": {
     "type": "string",
     "description": "C number, or none for a part off the board C followed by digits, or none for a part off the board"
    },
    "package": {
     "type": "string"
    },
    "placements": {
     "type": "integer",
     "minimum": 1,
     "description": "placements per board, at least 1 (sourcing rule 4)"
    },
    "held": {
     "type": "integer",
     "description": "quantity in the owner's personal library, 0 if not held"
    },
    "requirements": {
     "type": "array",
     "items": {
      "$ref": "requirement"
     }
    },
    "jlcpcb": {
     "type": "string",
     "description": "stockCount, canPresaleNumber, componentLibraryType, price at the need, time read, API call; or not read and why"
    },
    "digikey": {
     "type": "string",
     "description": "stock_available, lead_weeks, status, time read, API call; or not read and why"
    },
    "gate": {
     "type": "string",
     "description": "need = 5 boards x placements, threshold per S4, pass or fail per sourcing rule 4 or 6"
    },
    "lifecycle": {
     "type": "string",
     "description": "status and its source, longevity, first datasheet date, notices, distributor status"
    },
    "second_source": {
     "type": "string",
     "description": "the route of sourcing rule 5 that passes, with evidence, or none"
    },
    "alternates": {
     "$ref": "strs"
    },
    "driver_in_shared": {
     "type": "string",
     "description": "path under shared/ or none"
    },
    "reason": {
     "type": "string",
     "description": "why this rank"
    },
    "placements_basis": {
     "type": "string",
     "description": "fixed by the specification, or the range and its basis; placements is the top of the range (sourcing rule 4)"
    },
    "second_source_route": {
     "type": "string",
     "enum": [
      "alternate",
      "second-vendor",
      "none"
     ],
     "description": "the route of sourcing rule 5 this part passes by"
    },
    "second_source_part": {
     "type": "string",
     "description": "the alternate's part number when the route is alternate, else empty"
    }
   },
   "required": [
    "rank",
    "part",
    "maker",
    "lcsc",
    "package",
    "placements",
    "placements_basis",
    "held",
    "requirements",
    "jlcpcb",
    "digikey",
    "gate",
    "lifecycle",
    "second_source",
    "alternates",
    "driver_in_shared",
    "reason",
    "second_source_route",
    "second_source_part"
   ]
  },
  "dropped": {
   "type": "object",
   "properties": {
    "part": {
     "type": "string"
    },
    "maker": {
     "type": "string"
    },
    "reason": {
     "type": "string"
    }
   },
   "required": [
    "part",
    "maker",
    "reason"
   ]
  },
  "question": {
   "type": "object",
   "properties": {
    "function": {
     "type": "string"
    },
    "question": {
     "type": "string",
     "description": "one question the owner answers with a value, with its unit"
    },
    "why": {
     "type": "string",
     "description": "what P2 cannot qualify without it"
    },
    "blocks": {
     "type": "string",
     "enum": [
      "p2",
      "decision-only"
     ]
    },
    "decision": {
     "type": "string",
     "enum": [
      "none",
      "Q4",
      "Q8",
      "Q9"
     ]
    },
    "for_where": {
     "type": "string",
     "description": "the where (file:line) of the value this question asks for, or empty"
    }
   },
   "required": [
    "function",
    "question",
    "why",
    "blocks",
    "decision",
    "for_where"
   ]
  },
  "conflict": {
   "type": "object",
   "properties": {
    "parts": {
     "$ref": "strs"
    },
    "categories": {
     "$ref": "strs"
    },
    "kind": {
     "type": "string"
    },
    "description": {
     "type": "string"
    },
    "evidence": {
     "type": "string"
    }
   },
   "required": [
    "parts",
    "categories",
    "kind",
    "description",
    "evidence"
   ]
  },
  "gap": {
   "type": "object",
   "properties": {
    "spec_line": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "enum": [
      "no-part",
      "no-date",
      "unanswered",
      "value-not-found",
      "other"
     ]
    },
    "category": {
     "type": "string"
    },
    "description": {
     "type": "string"
    }
   },
   "required": [
    "spec_line",
    "kind",
    "category",
    "description"
   ]
  },
  "checks": {
   "type": "object",
   "properties": {
    "check_docs": {
     "type": "object",
     "properties": {
      "passed": {
       "type": "boolean"
      },
      "output": {
       "type": "string",
       "description": "the command's last lines"
      }
     },
     "required": [
      "passed",
      "output"
     ]
    },
    "ruff": {
     "type": "object",
     "properties": {
      "passed": {
       "type": "boolean"
      },
      "output": {
       "type": "string",
       "description": "the command's last lines"
      }
     },
     "required": [
      "passed",
      "output"
     ]
    },
    "jlc_stock": {
     "type": "object",
     "properties": {
      "passed": {
       "type": "boolean"
      },
      "output": {
       "type": "string",
       "description": "the command's last lines"
      }
     },
     "required": [
      "passed",
      "output"
     ]
    }
   },
   "required": [
    "check_docs",
    "ruff",
    "jlc_stock"
   ]
  },
  "figure": {
   "type": "object",
   "properties": {
    "figure": {
     "type": "string",
     "description": "a short name, unique within the return"
    },
    "value": {
     "type": "string"
    },
    "source": {
     "type": "string"
    }
   },
   "required": [
    "figure",
    "value",
    "source"
   ]
  }
 },
 "roles": {
  "P0": {
   "type": "object",
   "properties": {
    "versions": {
     "type": "string",
     "description": "Claude Code, git, python3, ruff, 7-Zip, curl_cffi"
    },
    "hosts": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "host": {
        "type": "string"
       },
       "url": {
        "type": "string"
       },
       "client": {
        "type": "string"
       },
       "http_status": {
        "type": "integer"
       },
       "bytes": {
        "type": "integer"
       },
       "status_marker": {
        "type": "string",
        "description": "the text the marker matched, or none"
       },
       "reachable": {
        "type": "boolean"
       },
       "note": {
        "type": "string"
       }
      },
      "required": [
       "host",
       "url",
       "client",
       "http_status",
       "bytes",
       "status_marker",
       "reachable",
       "note"
