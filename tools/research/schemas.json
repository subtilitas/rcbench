       },
       "verdict": {
        "type": "string",
        "enum": [
         "confirmed",
         "rejected"
        ]
       },
       "reason": {
        "type": "string"
       }
      },
      "required": [
       "index",
       "verdict",
       "reason"
      ]
     }
    },
    "added": {
     "type": "array",
     "items": {
