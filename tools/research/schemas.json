    "missed",
    "exclusions_not_holding",
    "missed_functions"
   ]
  },
  "rerank": {
   "type": "object",
   "properties": {
    "category": {
     "type": "string"
    },
    "functions": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "function": {
        "type": "string"
       },
       "ranking": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "rank": {
           "type": "integer"
          },
          "part": {
           "type": "string",
           "description": "a part of P2's shortlist or of new_candidates, by its exact part number"
          },
          "reason": {
           "type": "string"
          }
         },
         "required": [
          "rank",
          "part",
          "reason"
         ]
        }
       },
       "new_candidates": {
        "type": "array",
        "items": {
         "$ref": "candidate"
        },
        "description": "full records of the P3 candidates that qualify"
       },
       "dropped_from_p3": {
        "type": "array",
        "items": {
         "$ref": "dropped"
        }
       },
       "verify": {
        "type": "array",
        "description": "the parts P4 must verify: the first-ranked part, the sourcing-rule-5 alternate where the second source is an alternate, and in R10 and R12 the first-ranked part of each Q4 or Q8 alternative",
        "items": {
         "type": "object",
         "properties": {
          "part": {
           "type": "string"
          },
          "kind": {
           "type": "string",
           "enum": [
            "first",
            "alternate",
            "q-alternative"
           ]
          }
         },
         "required": [
          "part",
          "kind"
         ]
        }
       },
       "dropped_from_shortlist": {
        "type": "array",
        "items": {
         "$ref": "dropped"
        },
        "description": "P2 candidates the re-rank removes, each with its reason"
       },
       "decision": {
        "type": "string",
        "enum": [
         "none",
         "Q4",
         "Q8"
        ],
        "description": "Q4 on the R10 function that implements Q4, Q8 on the R12 function that implements Q8 (the non-volatile store), none elsewhere; that function's q-alternatives are the owner's choices"
       }
      },
      "required": [
       "function",
       "ranking",
       "new_candidates",
       "dropped_from_p3",
       "dropped_from_shortlist",
       "verify",
       "decision"
      ]
     }
