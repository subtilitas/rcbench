    },
    "stop": {
     "type": "boolean"
    },
    "stop_reasons": {
     "$ref": "strs"
    },
    "held": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "category": {
        "type": "string"
       },
       "host": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       }
      },
      "required": [
       "category",
       "host",
       "reason"
      ]
     }
    },
    "snapshot": {
     "type": "string",
     "description": "the created time of the parts database's manifest.json"
    }
   },
   "required": [
    "versions",
    "hosts",
    "jlcparts",
    "snapshot",
    "monostable",
    "checkout_head",
    "stop",
    "stop_reasons",
    "held"
   ]
  },
  "P1": {
   "type": "object",
   "properties": {
