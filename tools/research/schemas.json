       }
      },
      "required": [
       "question_id",
       "value",
       "source",
       "read_at"
      ]
     }
    },
    "functions": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "function": {
        "type": "string"
       },
       "requirements": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "name": {
           "type": "string"
          },
          "value": {
           "type": "string"
          },
          "source": {
           "type": "string"
          }
         },
         "required": [
          "name",
          "value",
          "source"
         ]
        }
       },
       "shortlist": {
        "type": "array",
        "items": {
         "$ref": "candidate"
        }
       },
       "dropped": {
        "type": "array",
        "items": {
         "$ref": "dropped"
        }
       }
      },
      "required": [
       "function",
       "requirements",
       "shortlist",
       "dropped"
      ]
     }
    },
    "report": {
     "type": "array",
     "items": {
      "$ref": "figure"
     },
     "description": "the figures the category reports for a decision or for P5 (R1 errata, R2 frames held, R3 on the '423 behaviour with I_off, R10 on Q4, R12 on Q8)"
    }
   },
   "required": [
    "category",
    "found_values",
    "functions",
    "report"
   ]
  },
  "P3": {
   "type": "object",
   "properties": {
    "category": {
     "type": "string"
    },
    "missed": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "function": {
        "type": "string"
       },
