   "say": [
    {
     "at": 1.2,
     "text": "This video shows how to load the firmware onto a new R C bench with the R B mod carrier: the panel from a browser, the I O M C U from a U S B drive. Then it shows the two ways to update later: from GitHub, and from a browser over Wi-Fi."
    },
    {
     "at": 21.08,
     "text": "Step 1. Download three files from the releases page on GitHub: the panel's zip file, the zip file of the I O M C U for the R B mod carrier, and the checksum file."
    },
    {
     "at": 35.04,
     "text": "Unpack both zip files. Two files in them are needed: the merged panel image, and the install image of the I O M C U."
    },
    {
     "at": 45.32,
     "text": "Step 2. The panel. Connect one of the panel's two U S B C sockets to a computer."
    },
    {
     "at": 52.72,
     "text": "Open the E-S-P web tool by Spacehuhn in Chrome or Edge."
    },
    {
     "at": 58.12,
     "text": "Click Connect and pick the panel's serial port."
    },
    {
     "at": 62.88,
     "text": "Add the merged panel image and leave its address at zero."
    },
    {
     "at": 68.44,
     "text": "Click Program and confirm. When the tool says done, restart the panel. It starts on its default settings."
    }
   ],
