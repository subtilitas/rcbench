     "anchor": "BAT.+",
     "at": [
      1180,
      170
     ],
     "title": "Input on the battery socket's pins",
     "text": "<b>BAT +</b> to <b>IN+</b>, <b>BAT −</b> to <b>IN−</b>. The socket stays free for the cell's plug. Solder with the cell unplugged.",
     "n": 3
    },
    {
     "from": 37.57,
     "to": 53.21,
     "anchor": "BOOST.IN+",
     "at": [
      1180,
      640
     ],
     "title": "No fuse",
     "text": "A short here is left to the cell's protection circuit. Keep the two wires short and apart.",
     "style": "warn",
     "size": "sm"
    },
    {
     "from": 57.51,
     "to": 71.67,
     "anchor": "BOOST.EN",
     "at": [
      1250,
      150
     ],
     "title": "Take off the 0 Ω resistor",
     "text": "Size 0402, 1.0 x 0.5 mm, between <b>EN</b> and <b>IN+</b>. A blob of solder on the tip picks it up.",
     "n": 4,
     "style": "warn"
    },
    {
     "from": 71.97,
     "to": 77.76,
     "anchor": "BOOST.IN+",
     "at": [
      300,
      150
     ],
     "title": "Check: EN is free",
     "text": "No continuity between <b>EN</b> and <b>IN+</b>.",
     "side": "b"
    },
    {
     "from": 81.06,
     "to": 88.73,
     "anchor": "BOOST.EN",
     "at": [
      1250,
      150
     ],
     "title": "10 kΩ from EN to IN−",
     "text": "A pull-down at the boost board. Without it the output can stay on when the enable wire is open."
    },
    {
     "from": 92.03,
     "to": 100.74,
     "anchor": "J4.11",
     "at": [
      300,
      150
     ],
     "title": "IO28 switches the supply",
     "text": "12-pin socket, wire 11, to <b>EN</b>. The board's print names every pin: GND is next to the USB-C end, IO29 at the far end.",
     "side": "b"
    },
    {
     "from": 103.04,
     "to": 112.16,
     "anchor": [
      18.5,
      74.8
     ],
     "at": [
      250,
      250
     ],
     "title": "I2C socket to the INA219",
     "text": "Print on the board, left to right: <b>GND, 3V3, SDA, SCL</b>. SDA is GPIO 6, SCL is GPIO 7.",
     "n": 5,
     "side": "b"
    },
    {
     "from": 112.46,
     "to": 125.58,
     "anchor": "INA.Vcc",
     "at": [
      1150,
      250
     ],
     "title": "3.3 V only",
     "text": "VCC from the I2C socket. A Qwiic or STEMMA QT cable has another pin order and does not fit this socket's wiring.",
     "style": "warn",
     "side": "b"
    },
    {
