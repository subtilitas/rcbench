   "labels": [
    {
     "from": 23.45,
     "to": 37.42,
     "anchor": "BAT.+",
     "at": [
      1180,
      170
     ],
     "title": "Input on the battery socket's pins",
     "text": "<b>BAT +</b> to <b>IN+</b>, <b>BAT −</b> to <b>IN−</b>. The socket stays free for the cell's plug. Solder with the cell unplugged.",
     "n": 3
    },
    {
     "from": 37.72,
     "to": 50.69,
     "anchor": "BOOST.IN+",
     "at": [
      1180,
      640
     ],
     "title": "No fuse",
     "text": "The two wires are on the cell without protection. Keep them short and apart.",
     "style": "warn",
     "size": "sm"
    },
    {
     "from": 53.99,
     "to": 63.22,
     "anchor": "BOOST.EN",
     "at": [
      1250,
      150
     ],
     "title": "10 kΩ from EN to IN−",
     "text": "A pull-down at the boost board. Without it the output can stay on when the enable wire is open.",
     "n": 4
    },
    {
     "from": 66.52,
     "to": 75.23,
     "anchor": "J4.11",
     "at": [
      300,
      150
     ],
     "title": "IO28 switches the supply",
     "text": "12-pin socket, wire 11, to <b>EN</b>. The board's print names every pin: GND is next to the USB-C end, IO29 at the far end.",
     "side": "b"
    },
    {
     "from": 77.53,
     "to": 86.65,
     "anchor": [
      18.5,
      74.8
     ],
     "at": [
      250,
      250
     ],
     "title": "I2C socket to the INA219",
     "text": "Print on the board, left to right: <b>GND, 3V3, SDA, SCL</b>. SDA is GPIO 6, SCL is GPIO 7.",
     "n": 5,
     "side": "b"
    },
    {
     "from": 86.95,
     "to": 100.07,
     "anchor": "INA.Vcc",
     "at": [
      1150,
      250
     ],
     "title": "3.3 V only",
     "text": "VCC from the I2C socket. A Qwiic or STEMMA QT cable has another pin order and does not fit this socket's wiring.",
     "style": "warn",
     "side": "b"
    },
    {
     "from": 105.37,
     "to": 116.97,
     "anchor": "BOOST.OUT+",
     "at": [
      60,
      150
     ],
     "title": "5.6 V zener across the output",
     "text": "Rated 2 W to 5 W. Cathode, the band, on <b>OUT+</b>. Anode on <b>OUT−</b>.",
     "n": 6,
     "side": "b"
    },
    {
     "from": 118.27,
     "to": 129.2,
     "anchor": [
      86,
      46
     ],
     "at": [
      1150,
      150
     ],
     "title": "470 µF, 10 V or more",
     "text": "Across <b>OUT+</b> and <b>OUT−</b>, at the boost board. <b>Mind the polarity:</b> the stripe is minus.",
     "style": "warn",
     "side": "b"
    },
    {
     "from": 131.5,
     "to": 138.1,
     "anchor": "INA.T+",
     "at": [
      60,
      640
     ],
     "title": "Through the shunt",
     "text": "<b>OUT+</b> to <b>Vin+</b>. The current then flows through the 0.1 Ω shunt to Vin−. The header's Vin pins stay empty: they are next to SDA.",
     "side": "t"
    },
    {
     "from": 139.4,
     "to": 148.26,
     "anchor": "TMT.+",
     "at": [
      200,
      150
     ],
     "title": "One supply for both connectors",
     "text": "<b>Vin−</b> to both <b>+</b> pins. <b>OUT−</b> to both <b>−</b> pins. The sensor reads the sum of both servos.",
     "side": "b"
    },
    {
     "from": 150.56,
     "to": 167.32,
     "anchor": [
      15,
      59
     ],
     "at": [
      330,
      420
     ],
     "title": "Wires 9 and 10",
     "text": "<b>TXD</b> (GPIO 0) to ESC <b>S</b>. <b>RXD</b> (GPIO 1) to TMT <b>S</b>.",
     "n": 7,
     "side": "b"
    },
    {
     "from": 197.31,
     "to": 207.95,
     "anchor": "ESC.+",
