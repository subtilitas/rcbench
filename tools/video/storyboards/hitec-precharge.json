   "say": [
    {
     "at": 0.8,
     "text": "The device on that wire answers with an open output. For a low level it pulls the wire to ground. For a high level it lets the wire go."
    },
    {
     "at": 11.7,
     "text": "And inside the device, a pull-down of 3 kilohms sits on the wire. A wire that is let go falls to zero volts. The pin reads every bit as low: the answer is there, and it cannot be seen."
    }
   ]
