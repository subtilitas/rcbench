   "say": [
    {
     "at": 0.8,
     "text": "Here is one answer byte, as the precharge receiver sees it. Each spike is one precharge."
    },
    {
     "at": 8.22,
     "text": "Where the servo lets the wire go, the spikes are tall and the samples read high. Where it pulls low, they stay short and the samples read low."
    },
    {
     "at": 19.64,
     "text": "A bit lasts 8.68 microseconds, and the pad samples every 1.09 microseconds: 8 samples to a bit."
    },
    {
     "at": 27.57,
     "text": "The decoder takes the samples as an inverted serial byte and reads the middle of each bit. It hands on the same bytes as the pull-up receiver."
    }
