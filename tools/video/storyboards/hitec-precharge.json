   "say": [
    {
     "at": 0.8,
     "text": "Now the real wire, on a logic analyser at 200 megasamples per second. The same register is read in three setups."
    },
    {
     "at": 10.0,
     "text": "With the pull-up resistor fitted, request and answer are plain levels: 5 bytes out and, 6.4 milliseconds later, 8 bytes back."
    },
    {
     "at": 20.16,
     "text": "Without the resistor, and without precharge, the wire never moves. No answer can be read."
    },
    {
     "at": 27.65,
     "text": "With precharge, the answer is there, as a train of pulses."
    },
    {
     "at": 32.84,
     "text": "One pulse every 1087 nanoseconds. A wire that is let go holds each pulse above the analyser's threshold for 280 nanoseconds. Where the servo pulls low, the pulse is gone."
    },
    {
     "at": 46.34,
     "text": "The simulated wire, read at the same threshold, gives the same picture. And the bytes are the same 8 in both receive modes."
    }
   ]
