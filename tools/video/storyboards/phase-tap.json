    }
   ],
   "say": [
    {
     "at": 0.8,
     "text": "The detector reads three time scales out of those stamps. The shortest spacing between rises is the carrier: 12 kilohertz."
    },
    {
     "at": 10.74,
     "text": "A rise after a longer low starts a new burst. From one burst to the next is one period of the tone: 478 microseconds, 2090 hertz."
    },
    {
     "at": 21.19,
     "text": "Every 8 milliseconds a window closes with the mean pitch of its periods."
    },
    {
     "at": 27.43,
     "text": "And when the line has been quiet for 3 milliseconds, the beep is over. The detector reports its first rise, its length and its pitch."
    }
   ]
