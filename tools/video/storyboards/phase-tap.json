   "labels": [
    {
     "from": 1.1,
     "to": 12.139999999999999,
     "anchor": [
      "c",
      "sw"
     ],
     "at": [
      1110,
      170
     ],
     "title": "The motor is the speaker",
     "text": "The ESC switches the supply onto the windings at the tone's rate. The tapped lead carries those pulses."
    },
    {
     "from": 12.74,
     "to": 21.189999999999998,
     "anchor": [
      "c",
      "lead"
     ],
     "at": [
      1110,
      170
     ],
     "title": "Bursts of the carrier",
     "text": "Each tone period holds one burst of PWM pulses. The model: 12 kHz, the FlyDragon's PWM setting, 3 pulses a burst."
    },
    {
     "from": 21.79,
     "to": 34.61,
     "anchor": [
      "c",
      "dz"
     ],
     "at": [
      1110,
      170
     ],
     "style": "ok",
     "title": "4.7 kΩ, 3.0 V zener, 8.2 kΩ",
     "text": "0.98 mA through the 4.7 kΩ at 7.6 V. An open RP2350 input needs the outer pull-down: its own does not hold it low."
    },
    {
     "from": 35.209999999999994,
     "to": 44.84,
     "anchor": [
      "c",
      "pin"
     ],
     "at": [
      1110,
      170
     ],
     "style": "ok",
     "title": "3.0 V at any supply",
     "text": "At 20 V, 3.6 mA flow through the 4.7 kΩ. The PD mini supplies up to 20 V."
    }
   ],
   "say": [
    {
     "at": 0.8,
     "text": "Where does a beep come from? The controller has no speaker. It drives the motor's windings at the pitch of the tone, and the motor itself sounds."
    },
    {
     "at": 12.44,
     "text": "On the lead, a tone is a train of short bursts at the supply voltage: here 7.6 volts, chopped at 12 kilohertz."
    },
    {
     "at": 21.49,
     "text": "The tap brings that lead to a logic pin. 4.7 kilohms in series limit the current. A 3 volt zener diode clamps the pin, and 8.2 kilohms hold it low while the lead floats."
    },
    {
     "at": 34.91,
     "text": "The clamp makes the pin independent of the supply. At 7.6 volts or at 20 volts on the lead, the pin sees the same 3 volts."
    }
   ]
  },
