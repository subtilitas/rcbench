   "say": [
    {
     "at": 0.8,
     "text": "A stick menu works like this. The controller is powered with the throttle at full, and after a few seconds it starts to count through its settings."
    },
    {
     "at": 12.59,
     "text": "One beep, pause. Two beeps, pause. Three beeps: setting number three. Move the stick now, and that setting is chosen."
    },
    {
     "at": 22.16,
     "text": "So the bench has to hear two things exactly: how many beeps make a group, and when the group is over."
    }
