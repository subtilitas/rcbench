   "labels": [
    {
     "from": 0.6,
     "to": 4.6,
     "anchor": [
      70,
      62.5
     ],
     "at": [
      1400,
      560
     ],
     "title": "R1 to R8 stay empty",
     "text": "Eight footprints for 120 Ω. A track joins the two pads of each.",
     "size": "sm"
    },
    {
     "from": 0.9,
     "to": 4.6,
     "anchor": "J6.2",
     "at": [
      60,
      300
     ],
     "title": "J6 takes no connector",
     "text": "Its pads take wires to a USB-C plug board in the last step.",
     "size": "sm",
     "side": "r"
    },
    {
     "from": 5.0,
     "to": 8.8,
     "anchor": [
      44.5,
      40
     ],
     "at": [
      60,
      250
     ],
     "title": "What goes on the board",
     "text": "5 modules on straight 2.54 mm pin strips, 2 angled 3 x 4 pin headers, 5 JST PH connectors, 1 Mini-Fit Jr, 1 USB-C plug board, a 3 V zener and 4.7 kΩ. For the rework: a wire, 2.2 kΩ and a 5.6 V zener.",
     "side": "r"
    },
    {
     "from": 11.7,
     "to": 15.4,
     "anchor": [
      80.88,
      58
     ],
     "at": [
      70,
      330
     ],
     "title": "PROGP03 runs to GPIO 26",
     "text": "GPIO 26 is an ADC pin and <b>not 5 V tolerant</b>. A Hitec or KST servo pulls the programming line up to its supply. Do this first, while the board is bare.",
     "side": "r",
     "style": "warn",
     "n": 1
    },
    {
     "from": 18.3,
     "to": 23.2,
     "anchor": [
      80.88,
      63
     ],
     "at": [
      70,
      300
     ],
     "title": "Scratch the track open at R1",
     "text": "Between the two pads of <b>R1</b>, the end footprint of the row, next to J1 pin 1. Afterwards the two pads must not conduct to each other.",
     "side": "r",
     "n": 1
    },
    {
     "from": 26.2,
     "to": 34.2,
     "anchor": [
      80,
      56.9
     ],
     "at": [
      70,
      330
     ],
     "title": "D1 and R9: the TAP input",
     "text": "D1 is a 3 V zener, its <b>banded end on the square pad</b>. R9 is 4.7 kΩ. Both lie flat on the board and are soldered on the back.",
     "side": "r",
     "n": 2
    },
    {
     "from": 37.2,
     "to": 48.4,
     "anchor": [
      85.4,
      37
     ],
     "at": [
      1400,
      250
     ],
     "title": "JST PH and Mini-Fit Jr",
     "text": "J3, J4, J5, J7 and J9 on the right edge and J8 on the left: on the module side, soldered on the back.",
     "size": "sm",
     "n": 3
    },
    {
     "from": 40.0,
     "to": 48.4,
     "anchor": "J6.2",
     "at": [
      60,
      300
     ],
     "title": "J6 stays empty",
     "text": "No connector here: its pads take wires in step 12.",
     "size": "sm",
     "side": "r",
     "style": "muted"
    },
    {
     "from": 51.4,
     "to": 59.2,
     "anchor": [
      66,
      76
     ],
     "at": [
      70,
      300
     ],
     "title": "J1 and J2: angled 3 x 4 headers",
     "text": "The pins point out over the board edge, towards the case wall. J1 carries the programming ports, J2 the servo outputs. Soldered on the back.",
     "side": "r",
     "n": 4
    },
    {
     "from": 73.0,
     "to": 83.8,
     "anchor": [
      70,
      9
     ],
     "at": [
      60,
      300
     ],
     "title": "M1 · RP2350-CAN",
     "text": "The USB-C socket at the board edge. 2 x 20 pins: solder each on the module, then turn the board and solder each on the back.",
     "side": "r",
     "n": 5
    },
    {
     "from": 86.8,
     "to": 98.2,
     "anchor": [
      43,
      12
     ],
     "at": [
      1330,
      250
     ],
     "title": "M8 and M7: the same way",
     "text": "On pin strips with the plastic between: four pin pairs each and M7's EN pin, soldered on both sides. M8 makes the IOmcu's 5 V. M7 makes the 5 V of the programming ports and is switched through <b>EN</b>.",
     "n": 6
    },
    {
     "from": 101.2,
     "to": 106.2,
     "anchor": [
      28,
      62
     ],
     "at": [
      1260,
      250
     ],
     "title": "M5 · INA3221",
     "text": "On an 8-pin strip, the plastic between, soldered on both sides.",
     "size": "sm",
     "n": 7
    },
    {
     "from": 121.8,
     "to": 132.4,
     "anchor": [
      17,
      12
     ],
     "at": [
      1300,
      250
     ],
     "title": "M6 · USB-C PD trigger",
     "text": "Its <b>two large holes</b> the same way: bare wire through both boards, filled with solder. Set its DIP switch to <b>15 V</b>.",
     "n": 8
    },
    {
     "from": 135.2,
     "to": 146.2,
     "anchor": [
      69,
      61.4
     ],
     "at": [
      70,
      560
     ],
     "title": "Wire GPIO 15 to the outer pad",
     "text": "From the module's pad 20, <b>GP15</b>, to the pad of R1 that leads on to J1. GPIO 26 ends at the inner pad and stays unused.",
     "side": "r",
     "n": 9
    },
    {
     "from": 149.0,
     "to": 159.4,
     "anchor": [
      33.8,
      41.1
     ],
     "at": [
      1370,
      250
     ],
     "title": "2.2 kΩ from EN to GND",
     "text": "On top of the module, from <b>EN</b> to the <b>GND</b> pad beside it. An open EN reads as on: the pull-down keeps the ports' 5 V off while the IOmcu is in reset, in BOOTSEL or unpowered.",
     "n": 10
    },
    {
     "from": 161.8,
     "to": 172.4,
     "anchor": [
      56.06,
      33.6
     ],
     "at": [
      70,
      250
     ],
     "title": "5.6 V zener from OUT+ to GND",
     "text": "A 2 W or 5 W part on top of the module, its <b>banded end, the cathode, on OUT+</b>. A braking servo feeds energy back into the 5 V, and M7 latches off above about 6.0 V. The zener takes that energy.",
     "side": "r",
     "n": 11
    },
    {
     "from": 175.4,
     "to": 190.2,
     "anchor": [
      -3,
      41.6
     ],
     "at": [
      1260,
      570
     ],
     "title": "J6: four wires to a USB-C plug board",
     "text": "No connector on J6. <b>15 V to V, GND to G.</b> The UART crosses over: the IOmcu's <b>TX, GPIO 7, to D−</b>, its <b>RX, GPIO 6, to D+</b>. The PD mini sends on D+ and listens on D−.",
     "side": "t",
     "n": 12
    },
    {
     "from": 182.6,
     "to": 190.2,
     "anchor": [
      -19,
      41
     ],
     "at": [
      60,
      620
     ],
     "title": "Into the PD mini only",
     "text": "The plug carries 15 V on V. It goes into the PD mini's USB-C socket and nowhere else.",
     "size": "sm",
     "side": "t",
     "style": "warn"
    }
   ],
