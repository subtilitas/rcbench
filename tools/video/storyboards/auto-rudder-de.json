   "say": [
    {
     "at": 1.0,
     "text": "Dieses Video zeigt, wie die rcbench die Ausschläge eines Ruders einstellt. Die Bench steuert das Servo, misst den Winkel des Ruders mit einem Sensor und programmiert die Endpunkte des Servos, bis beide Ausschläge stimmen."
    },
    {
     "at": 17.68,
     "text": "Das Beispiel ist eine Klappe in einem Flügelabschnitt. Ein KST X10 liegt unter der Schale auf einem Rahmen mit Gegenlager und bewegt die Klappe über eine Schubstange."
    },
    {
     "at": 30.52,
     "text": "Schritt 1. Ein Pad Gecko Tape auf die Klappe kleben."
    },
    {
     "at": 36.24,
     "text": "Den Sensor auf das Pad drücken. Seine X- oder Y-Achse muss entlang der Scharnierlinie liegen. Die Z-Achse lehnt die Bench ab."
    },
    {
     "at": 45.96,
     "text": "Das Servo in einen Programmier-Port der Bench stecken."
    }
   ]
