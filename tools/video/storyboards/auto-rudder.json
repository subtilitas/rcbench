   ],
   "say": [
    {
     "at": 0.6,
     "text": "Step 4. Open rudder auto. Enter the throw each end should reach: here 20 degrees at 1000 and at 2000 microseconds."
    },
    {
     "at": 10.72,
     "text": "With the surface at neutral, tap zero."
    },
    {
     "at": 14.76,
     "text": "Then hold arm and start for 2 seconds."
    },
    {
     "at": 18.86,
     "text": "The bench switches the supply on, arms, and reads the servo."
    },
    {
     "at": 24.66,
     "text": "It drives the 1000 microsecond end and waits until the sensor's angle is still: 36 degrees."
    },
    {
     "at": 32.94,
     "text": "Too far. It writes a smaller end point into the servo and measures again: 22 degrees."
    },
    {
     "at": 40.76,
     "text": "The other end goes the same way: measure, write, measure."
    },
    {
     "at": 56.76,
     "text": "A verify pass then measures both ends and the center once more, each from the same side."
    },
    {
     "at": 83.26,
     "text": "Pass. Both ends are within half a degree of their goal, and the report is on the S D card."
    }
   ]
  },
