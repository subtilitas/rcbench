# The sensor node on a Waveshare ESP32-C6-Zero (ESP32-C6FH4, 4MB flash in
# the package).
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The console on the board's USB-C socket (USB Serial/JTAG).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Bluetooth LE: NimBLE host and controller on the chip, a peripheral for one
# central.  No security manager: the panel's host has none.  Legacy
# advertising, as the panel scans.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# No Wi-Fi.
CONFIG_ESP_WIFI_ENABLED=n

# A timer wake from deep sleep loads the image without checking it again,
# for a shorter wake.  Secure boot is not used.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# A new image from an update over Bluetooth LE starts once on trial and
# marks itself kept at its first connection (firmware/devota); a start
# before that goes back to the image before it.  A timer wake from deep
# sleep, with the option above, starts the image the start before it
# chose, so a node on trial stays on trial across its 10s wakes.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
