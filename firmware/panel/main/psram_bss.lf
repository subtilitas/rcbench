# The zero-initialised state of the screens and of the card and page
# helpers, in PSRAM (pseudo-static random-access memory) instead of
# internal RAM.
#
# SPDX-License-Identifier: MIT
#
# Internal RAM holds what must not live in PSRAM: interrupt handlers'
# state, driver buffers and the FreeRTOS objects.  How much internal RAM
# the panel uses on the ESP32-P4, and how much the radio's driver through
# the ESP32-C6 will take, is not measured; no tool holds a budget for it.
#
# What moves is .bss only, object by object, and only an object whose state
#
# - no interrupt handler reads or writes: the panel's IRAM (instruction
#   RAM) handlers are display.c's frame-done and VSYNC callbacks, and their
#   state stays internal;
# - no DMA (direct memory access) reads or writes: a DMA transfer from or
#   to PSRAM needs the cache written back or invalidated around it, which
#   the code that uses these objects does not do;
# - holds no atomic, spinlock, mutex or queue: those stay in internal RAM.
#   Whether the ESP32-P4's atomic instructions work on PSRAM is not
#   measured, and nothing here relies on it.
#
# A flash write (OTA (over-the-air) update, NVS (non-volatile storage),
# the drawing store) closes the cache, and PSRAM with it.  For its length
# the writing task runs from IRAM and the other core waits in IRAM; no code
# that reads these objects runs.
#
# CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY also puts in PSRAM the .bss
# that ESP-IDF's own linker fragments name, lwIP's among them.

[mapping:rcbench_ui_psram]
archive: libui.a
entries:
    log_viewer_screen (extram_bss)
    servo_screen (extram_bss)
    ui_watermark (extram_bss)
    supply_screen (extram_bss)
    motor_screen (extram_bss)
    motor_workbench (extram_bss)
    motor_settings_page (extram_bss)
    motor_program_page (extram_bss)
    esc_stick_pages (extram_bss)
    esc_stick_panel (extram_bss)
    kst_panel (extram_bss)
    analyser_screen (extram_bss)
    wifi_screen (extram_bss)
    ui_band (extram_bss)

[mapping:rcbench_bench_psram]
archive: libbench.a
entries:
    kst_card (extram_bss)

[mapping:rcbench_logfile_psram]
archive: liblogfile.a
entries:
    log_csv (extram_bss)
    log_reader (extram_bss)

[mapping:rcbench_esc_psram]
archive: libesc.a
entries:
    esc_registry (extram_bss)

[mapping:rcbench_webaccess_psram]
archive: libwebaccess.a
entries:
    wa_zip (extram_bss)
    wa_page (extram_bss)
