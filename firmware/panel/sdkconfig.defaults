# Target -------------------------------------------------------------------
# The ESP32-P4 on the 7-inch display board from Waveshare is chip revision
# 3.2.  Images for revision 3.x and for 1.x are not interchangeable: a v3
# build needs CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n.  Minimum revision 3.1;
# a 3.2 chip satisfies it.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y

# Flash --------------------------------------------------------------------
# 32 MB of NOR flash on the board.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM --------------------------------------------------------------------
# 32 MB of hex-mode PSRAM (pseudo-static random-access memory) in the chip's
# package.  Both frame buffers (2 x 1,228,800 bytes) live in it, and the
# DSI (Display Serial Interface) host's DMA (direct memory access) reads
# about 74 MB/s out of it for the scan-out at 60 Hz.  200 MHz is ESP-IDF
# v5.5.5's default for this chip; 80 MHz is the setting to compare it
# against.  The bandwidth the CPU (central processing unit) gets beside
# the scan-out is not measured.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
#
# Code and constants stay in flash; only the frame buffers and the data
# psram_bss.lf names live in PSRAM.
CONFIG_SPIRAM_XIP_FROM_PSRAM=n
CONFIG_SPIRAM_RODATA=n
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=n
CONFIG_SPIRAM_MEMTEST=n
#
# Zero-initialised data in PSRAM where a linker fragment asks for it:
# main/psram_bss.lf names the panel's objects and why each is safe there.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Cache --------------------------------------------------------------------
# ESP-IDF's defaults: 128 KB of L2 cache, 64-byte lines.  Waveshare's
# examples run 256 KB with 128-byte lines; the effect on the frame rate here
# is not measured.

# LCD ----------------------------------------------------------------------
# The DSI host's interrupt runs while a flash write has the cache off, so
# the frame-done event that restarts the scan-out is not held for the
# length of a settings save, a drawing's keep or an update.  The display's
# two callbacks are in IRAM (instruction RAM) and touch internal RAM only.
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y

# Performance --------------------------------------------------------------
# ESP-IDF (Espressif Internet-of-Things Development Framework) defaults to
# -Og.  The rasteriser is tight pixel loops; -O2 raises the frame rate.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Scheduler ----------------------------------------------------------------
CONFIG_FREERTOS_HZ=1000
# The start-up report lists every task with its core and priority
# (main.c, uxTaskGetSystemState()), which needs the trace facility.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Main task stack ----------------------------------------------------------
# app_main runs the UI: every screen's enter, tick, event and render is
# called on the main task.  ESP-IDF's default stack, 3584 bytes, is below
# the UI's deepest call chain, 3856 bytes in the ESP32-S3's Xtensa code,
# through the log viewer's render and snprintf().  8192 bytes hold that with room.  The
# chain on the ESP32-P4's RISC-V code is not measured.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Console ------------------------------------------------------------------
# UART0 is the primary console and USB-Serial-JTAG (the chip's built-in
# serial and debug bridge) the secondary.  Which of the board's two USB-C
# sockets reaches which is not traced.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Card file names ----------------------------------------------------------
#
# Long file names, so a file copied from a computer keeps its name: an ESC
# (electronic speed controller) profile in /ESC/ is named after its id, which
# is longer than 8.3 allows.  Without this, "hobbywing-flyfun-8item.json"
# reads back as "HOBBYW~1.JSO" and matches no suffix.  The name buffer is
# taken from the heap per call, not from the calling task's stack.  Names of
# 64 characters or more are still skipped by storage_walk(), which cannot
# hand them back whole.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# File names in UTF-8 ------------------------------------------------------
#
# The Wi-Fi page lists and sends the card's files by name, and a browser
# reads names as UTF-8.  Without this, a name with characters outside ASCII
# (American Standard Code for Information Interchange) comes out of FatFs
# in code page 437.
CONFIG_FATFS_API_ENCODING_UTF_8=y
# Volume label ------------------------------------------------------------
#
# The log viewer's header names the card by its volume label, which
# f_getlabel() reads; it is compiled only with this.
CONFIG_FATFS_USE_LABEL=y

# Application slots ---------------------------------------------------------
#
# Two application slots and otadata (partitions.csv).  An update writes the
# slot that is not running; the bootloader starts a new build once as a
# trial, and a start that does not reach fw_ota_boot_check() with the
# display and touch up goes back to the build before it.  No anti-rollback,
# no secure boot, no flash encryption, no signing: an image is checked by
# its header, its project name and its appended SHA-256 (secure hash
# algorithm, 256 bits), which say what it is and that it arrived whole, and
# not who built it.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
#
# The ESP32-P4's second-stage bootloader sits at 0x2000.  The partition
# table at 0xC000 leaves it 40,960 bytes; with rollback and the INFO log
# level it is 24,896 bytes.
CONFIG_PARTITION_TABLE_OFFSET=0xC000
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y

# Wi-Fi through the ESP32-C6 -----------------------------------------------
#
# The ESP32-P4 has no radio.  The 7-inch display board from Waveshare
# carries an ESP32-C6-MINI-1 whose SDIO (Secure Digital input/output) slave
# pins are wired to the P4's SDMMC (SD/MMC host) slot 1; the SD card is on
# slot 0.  esp_wifi_remote gives wifi_access.c the esp_wifi API, and
# esp_hosted carries each call and every network frame over SDIO
# (components/wifi_access/idf_component.yml).  lwIP (lightweight IP stack),
# the page's server and the TLS (transport layer security) client run on
# the P4; the C6 runs the radio and its driver.
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
#
# The board's wiring is in components/board/include/board_pins.h
# (BOARD_C6_*); wifi_radio.c fails the build when the values here differ.
# Espressif's ESP32-P4 Function EV Board uses the same pins; they are named
# here rather than taken from that board's choice.
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
#
# The C6 is reset once per start of the panel, at the radio's first start,
# and given 1500 ms (CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS) to answer.
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
#
# A failed SDIO link does not restart the panel: esp_hosted's default would,
# and a restart drops the link to the IOmcu and the heartbeat.  The failure
# ends the Wi-Fi session instead, and Wi-Fi stays off until the next start
# (components/wifi_access/wifi_radio.c).
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n
#
# Nothing the panel does not use: no memory monitor requests to the C6, no
# console commands of esp_hosted's, no enterprise (EAP, extensible
# authentication protocol) networks: WPA2 and WPA3 personal only.
CONFIG_ESP_HOSTED_MEM_MONITOR=n
CONFIG_ESP_HOSTED_CLI_ENABLED=n
CONFIG_WIFI_RMT_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_REMOTE_EAP_ENABLED=n
#
# Nothing of the radio's is kept in the C6's NVS (non-volatile storage);
# wifi_access.c also starts the driver with nvs_enable 0.
CONFIG_WIFI_RMT_NVS_ENABLED=n

# Network -------------------------------------------------------------------
#
# lwIP's buffers come from PSRAM where the
# stack allows, so internal RAM keeps what the display and the bench need.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
#
# lwIP's task on core 0, with the UI (user interface).  Core 1 runs the
# control task, which owns STOP and the heartbeat.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# A TCP (transmission control protocol) connection's send buffer: 8
# segments of 1440 bytes, 11,520 bytes, where ESP-IDF's default is 4.  A
# download moves at most one send buffer per round trip.  With 4 segments
# in flight, a lost segment other than the first draws fewer than the 3
# duplicate acknowledgements a fast retransmit needs and waits out the
# retransmission time-out instead: 1,500 ms at the start
# (CONFIG_LWIP_TCP_RTO_TIME), longer with each further loss.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
# SO_LINGER, so a download that fails resets its connection
# (wifi_sock.c, wifi_sock_drop()) and frees what it had queued at once.
CONFIG_LWIP_SO_LINGER=y
# A phone browser's request headers run past the default 512 bytes, and a
# card path of WA_PATH_MAX (384) bytes is up to 1152 bytes percent-encoded.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1280

# TLS (transport layer security) to GitHub --------------------------------
#
# The server's chain is checked against ESP-IDF's bundle of the common
# certificate authorities, not the full one: github.com chains to USERTrust
# ECC, its release files' host to ISRG Root X1, and both are in it.  A
# bundle of those two alone would be smaller and would stop working the day
# GitHub changes its authority.  No clock is set, so no certificate's dates
# are checked.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# mbedTLS's memory, the 16 KB record buffer for what arrives among it, in
# PSRAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
