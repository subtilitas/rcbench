# ESP32-P4 additions to sdkconfig.defaults.  ESP-IDF reads this file after
# sdkconfig.defaults when the target is esp32p4.

# Wi-Fi through the ESP32-C6 ---------------------------------------------
#
# The ESP32-P4 has no radio.  The 7-inch display board from Waveshare
# carries an ESP32-C6-MINI-1 whose SDIO (Secure Digital input/output) slave
# pins are wired to the P4's SDMMC (SD/MMC host) slot 1; the SD card is on
# slot 0.  esp_wifi_remote gives wifi_access.c the esp_wifi API, and
# esp_hosted carries each call and every network frame over SDIO
# (components/wifi_access/idf_component.yml).  lwIP (lightweight IP stack),
# the page's server and the TLS (transport layer security) client run on
# the P4; the C6 runs the radio and its driver.
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
#
# The board's wiring, from its schematic: C6 IO19 to P4 GPIO18 (CLK), IO18
# to GPIO19 (CMD), IO20 to IO23 to GPIO14 to GPIO17 (D0 to D3), each line
# pulled up by 51 kOhm; the C6's EN (chip enable) to GPIO54 through 0 Ohm,
# pulled up by 10 kOhm with 1 uF, so a low on GPIO54 holds the C6 in reset.
# Espressif's ESP32-P4 Function EV Board uses the same pins; they are named
# here rather than taken from that board's choice.
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
#
# The C6 is reset once per start of the panel, at the radio's first start,
# and given 1500 ms (CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS) to answer.
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
#
# A failed SDIO link does not restart the panel: esp_hosted's default would,
# and a restart drops the link to the IOmcu and the heartbeat.  The failure
# ends the Wi-Fi session instead, and Wi-Fi stays off until the next start
# (components/wifi_access/wifi_radio.c).
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n
#
# Nothing the panel does not use: no memory monitor requests to the C6, no
# console commands of esp_hosted's, no enterprise (EAP, extensible
# authentication protocol) networks: WPA2 and WPA3 personal only, as on the
# ESP32-S3.
CONFIG_ESP_HOSTED_MEM_MONITOR=n
CONFIG_ESP_HOSTED_CLI_ENABLED=n
CONFIG_WIFI_RMT_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_REMOTE_EAP_ENABLED=n
#
# Nothing of the radio's is kept in the C6's NVS (non-volatile storage);
# wifi_access.c also starts the driver with nvs_enable 0.
CONFIG_WIFI_RMT_NVS_ENABLED=n
