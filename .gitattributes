# The repository stores text as LF (line feed), and every checkout gets LF.
#
# Without this a Windows checkout writes CRLF (carriage return, line feed) and
# a Linux checkout of the same tree over a mount writes LF, so every file
# shows as rewritten and `git add shared/` sweeps in files whose only change
# is the line endings.
* text=auto eol=lf

# Not text.  Declared rather than left to git's detection: a golden
# screenshot converted as text is a corrupted image.
*.png binary
*.uf2 binary
*.bin binary
