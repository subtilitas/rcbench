  "sources": [
    {
      "file": "Sunrise_PRO.pdf",
      "pages": "2-4",
      "language": "en",
      "url": "https://www.f3x.de/media/pdf/dd/93/94/Electronic-Speed-Controller-Users-Manual.pdf"
    }
  ],
  "automatable": "full",
  "automatable_note": "The brake gesture is unclear in the manual; battery type and timing are clear.",
  "scheme": {
    "type": "count",
    "entry": {
      "throttle": "max",
      "when": "before_power_on",
      "hold_ms": 5000,
      "confirm_signal": "4 beeps after about 5 s",
      "steps": [
        "Transmitter on, throttle at max",
        "Connect battery",
        "Wait about 5000 ms: 4 beeps, programming mode entered"
      ]
    },
    "announce": {
      "what": "value",
      "encoding": "count",
      "long_equals_short": null,
      "beep_ms": null,
      "gap_ms": null,
      "group_gap_ms": null,
      "repeat": 5,
      "description": "The ESC plays 5 single beeps, then 5 double beeps, 5 triple, 5 quad, 5 penta beeps, and repeats. A group of N beeps (repeated 5 times) is one choice: groups 1-3 are battery types, groups 4-5 are timing."
    },
    "select": {
      "throttle": "min",
      "within_ms": null,
      "description": "Move the throttle to min while the group of the wanted choice plays; the mode is saved. Whether the stick may be held for the whole group of 5 is not stated."
    },
    "skip": {
      "throttle": "none",
      "description": "Keep the throttle at max."
    },
    "confirm_signal": "Not stated; the manual says the mode is saved and the battery may be disconnected.",
    "exit": "Disconnect the battery after the mode is saved. One parameter per power cycle.",
    "changes_per_entry": "one",
    "reset_to_defaults": null,
    "description": "Throttle max, battery on, wait 5 s for 4 beeps. Groups of 5 single, 5 double, 5 triple, 5 quad and 5 penta beeps loop. Throttle to min during the group of the wanted choice saves it. One parameter per power cycle; other parameters need the program card."
  },
  "items": [
    {
      "number": 1,
      "name": "Battery type",
      "key": "battery_type",
      "values": [
        {
          "number": 1,
          "name": "Li-xx (1 beep group)"
        },
        {
          "number": 2,
          "name": "NiCd / NiMH (2 beep group)"
        },
        {
          "number": 3,
          "name": "LiFe (3 beep group)"
        }
      ],
      "applies_to": null,
      "source_page": "2-3"
    },
    {
      "number": 2,
      "name": "Timing",
      "key": "timing",
      "values": [
        {
          "number": 4,
          "name": "automatic (4 beep group)"
        },
        {
          "number": 5,
          "name": "high (5 beep group)"
        }
      ],
      "applies_to": null,
      "source_page": "2-3"
    }
  ],
  "unknowns": [
    "Beep duration, gap and loop length in ms are not stated.",
    "The order and number of tones in the loop are given only by the chart; each tone repeats 4 times in the chart notation.",
    "Whether the throttle must stay at max between tones is not stated beyond 'if left at max beyond 5 s the sequence starts'.",
    "Chart tone glyphs are text approximations; pitch information is not available.",
    "Which group sets the brake is unclear: the text says 'the first quad group' toggles brake off/medium, but quad beeps are also the automatic-timing choice.",
    "Duration of the 5 s wait is 'about'.",
    "Confirmation tone after saving is not described.",
    "Value numbers of items 1 and 2 are the beep counts of the group (1-3 and 4-5)."
  ],
  "notes": [
    "Sunrise_PRO.pdf lists more parameters (acceleration, cutoff voltage and mode, rotation direction) that are set only with the program card.",
    "Factory defaults: brake on medium, timing automatic, acceleration medium, battery Li-ion/Li-polymer, cutoff medium, cutoff mode slow down, rotation rightward. The brake default conflicts with the stick description 'change from Brake-off into Brake-Medium'.",
    "Brake is not an item here: the manual toggles it with 'the first quad group', which is also the automatic-timing choice, so no beep count can be given for it."
  ],
