  "automatable": "full",
  "automatable_note": "The tones differ in rhythm and pitch; the bench counts current pulses only, whether the tones can be told apart by current is untested.",
  "scheme": {
    "type": "melody_groups",
    "entry": {
      "throttle": "max",
      "when": "before_power_on",
      "hold_ms": 2000,
      "confirm_signal": "4 groups of two fast beeps, then a cycle of distinct tones and melodies",
      "steps": [
        "Transmitter on, throttle at max",
        "Connect battery",
        "Wait 2000 ms: 4 groups of two fast beeps (within 4 s of power-up per the tone chart)",
        "Distinct tones then play in a loop"
      ]
    },
    "announce": {
      "what": "item_then_value",
      "encoding": "melody",
      "long_equals_short": null,
      "beep_ms": null,
      "gap_ms": null,
      "group_gap_ms": null,
      "repeat": 4,
      "description": "Each setting option has its own tone, repeated four times. The tone alone identifies both function and value; there are no item or value numbers. Numbers in this profile follow the manual's chart order."
    },
    "select": {
      "throttle": "min",
      "within_ms": null,
      "description": "While the tone of the wanted option plays, move the throttle to min (the manual says lowest, OFF). The tone stops when the setting is saved."
    },
    "skip": {
      "throttle": "none",
      "description": "Keep the throttle at max and wait for the next tone."
    },
    "confirm_signal": "The tone stops.",
    "exit": "The ESC saves and exits the function after one change. Power-cycle to change another.",
    "changes_per_entry": "one",
    "reset_to_defaults": "Select the restore-defaults tone (long dashes) and move the throttle to min.",
    "description": "Throttle at max, battery on, wait 2 s for 4 groups of two fast beeps. Tones for every setting option loop. Moving the throttle to min while the wanted tone plays saves it; the sound stops. One setting per power cycle."
  },
