  "automatable": "full",
  "automatable_note": "Boat ESCs: the throttle range must be calibrated first; neutral/brake positions matter for the 'forward and backward' mode.",
  "scheme": {
    "type": "short_long",
    "entry": {
      "throttle": "max",
      "when": "before_power_on",
      "hold_ms": 7000,
      "confirm_signal": "Two short beeps after about 2 s, special tone (56712) after about 5 s more",
      "steps": [
        "Transmitter on, throttle at max",
        "Connect battery (ESC switch on where fitted)",
        "Wait about 2000 ms: Beep-Beep",
        "Wait about 5000 ms more: special tone, programming mode entered"
      ]
    },
    "announce": {
      "what": "item_then_value",
      "encoding": "short_long",
      "long_equals_short": 5,
      "beep_ms": null,
      "gap_ms": null,
      "group_gap_ms": null,
      "repeat": null,
      "description": "4 item tones loop: 1-4 short beeps for items 1-4. Value N is N short beeps for N 1-4, 1 long beep plus (N-5) short for N 5-8."
    },
    "select": {
      "throttle": "min",
      "within_ms": 3000,
      "description": "Item: throttle to min (full brake) within 3000 ms after the wanted item tone. V1 manual also accepts neutral."
    },
    "value_select": {
      "throttle": "max",
      "within_ms": null,
      "description": "Value: throttle to max (full throttle) when the wanted value tone sounds. Holding max for over 2 s after the saved tone returns to the item loop."
    },
    "skip": {
      "throttle": "none",
      "description": "Leave the throttle unchanged and wait for the next tone."
    },
    "confirm_signal": "Special tone (1515) after a value is stored.",
    "exit": "After the saved tone move the throttle to min within 2000 ms, or disconnect the battery.",
    "changes_per_entry": "many",
    "reset_to_defaults": null,
    "description": "Same gesture set as the Hobbywing FlyFun menu with only four items: running mode, cell count, cutoff threshold, timing. No exit or reset item exists."
  },
