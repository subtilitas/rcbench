  "automatable": "full",
  "automatable_note": null,
  "scheme": {
    "type": "short_long",
    "entry": {
      "throttle": "max",
      "when": "before_power_on",
      "hold_ms": 2000,
      "confirm_signal": "Four times two fast beeps about 2 s after power-up at full throttle.",
      "steps": [
        "Transmitter on, throttle stick to full throttle.",
        "Connect the battery.",
        "After about 2 s: four groups of two fast beeps. Programming mode is active."
      ]
    },
    "announce": {
      "what": "item_then_value",
      "encoding": "short_long",
      "long_equals_short": 5,
      "beep_ms": null,
      "gap_ms": null,
      "group_gap_ms": null,
      "repeat": 0,
      "description": "Items 1 to 4 sound as 1 to 4 short signals; item 5 and above sound as one long signal plus the remaining short signals (item 6 = long plus 1 short, 9 = long plus 4, 10 = two long). Values sound the same way: value N as N fast beeps up to 4, one long tone for 5, long plus short for 6 to 9. A melody marks entry into an item."
    },
    "select": {
      "throttle": "max",
      "within_ms": null,
      "description": "With the item's value announced, full throttle stores it and the ESC moves on to the next item."
    },
    "skip": {
      "throttle": "none",
      "description": "Leave the stick at full throttle: the item sequence runs on by itself. Throttle to idle (neutral) while an item sounds enters its value list."
    },
    "confirm_signal": "Not described beyond the move to the next item; no separate stored-tone is named.",
    "exit": "Disconnect the battery.",
    "changes_per_entry": "many",
    "reset_to_defaults": "Item 4 (reset): full throttle on the reset item restores the factory settings (brake off, LiPo auto cells, cutoff 3.0 V / 60%, timing auto, SBEC 5.0 V, governor off, rotation clockwise, start strength medium 30%, cutoff mode throttling). The acknowledging tone is not described.",
    "description": "Full throttle at power-up; after 2 s four double beeps. The items cycle automatically. Throttle to idle during an item gives a melody and then the item's values in turn; full throttle on the right value stores it and the ESC goes to the next item. Disconnecting the battery ends programming."
  },
