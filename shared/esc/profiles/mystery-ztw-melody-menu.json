  "sources": [
    {
      "file": "Mystery_ESC.pdf",
      "pages": "2-6",
      "language": "en",
      "url": "https://www.uruktech.com/wp-content/uploads/2016/07/Mystery-ESC-Instruction-manual.pdf"
    },
    {
      "file": "Readytosky_30A_ESC.pdf",
      "pages": "1-4",
      "language": "en",
      "url": "https://cdn.shopify.com/s/files/1/1052/4162/files/30AESCmanual.pdf"
    }
  ],
  "automatable": "full",
  "automatable_note": "The tones differ in rhythm and pitch; the bench counts current pulses only, whether the tones can be told apart by current is untested. OPTO models have no BEC.",
  "scheme": {
    "type": "melody_groups",
    "entry": {
      "throttle": "max",
      "when": "before_power_on",
      "hold_ms": null,
      "confirm_signal": "Two short beeps after power-up, then (within the first 5 s) the throttle-calibration window",
      "steps": [
        "Transmitter on, throttle at max",
        "Connect battery",
        "Wait for two short beeps: programming mode entered",
        "If the throttle goes to min within 5 s, the throttle calibration is changed (avoid this)",
        "Keep the throttle at max beyond 5 s: the ESC starts the tone sequence"
      ]
    },
    "announce": {
      "what": "item_then_value",
      "encoding": "melody",
      "long_equals_short": null,
      "beep_ms": null,
      "gap_ms": null,
      "group_gap_ms": null,
      "repeat": 4,
      "description": "Each setting option has its own tone pattern (dots, dashes, wave, V and slash shapes in the chart), repeated four times. One tone identifies function and value. Item numbers 1-10 follow the manual's setting list."
    },
    "select": {
      "throttle": "min",
      "within_ms": null,
      "description": "Move throttle to min while the wanted tone plays. The ESC emits two beeps to confirm the new setting is stored."
    },
    "skip": {
      "throttle": "none",
      "description": "Keep the throttle at max and wait for the next tone."
    },
    "confirm_signal": "Two beeps (**) after the setting is stored.",
    "exit": "One setting per power cycle: disconnect the battery, wait 5 s, reconnect.",
    "changes_per_entry": "one",
    "reset_to_defaults": "Select the restore tone (long dashes) and move the throttle to min.",
    "description": "Throttle max, battery on, two short beeps. After 5 s with the throttle still at max the tone loop starts; throttle to min while the wanted tone plays saves it and two beeps confirm. Disconnect, wait 5 s, repeat for another setting."
  },
