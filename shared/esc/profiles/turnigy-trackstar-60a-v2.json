  "automatable": "full",
  "automatable_note": "The ESC has a power switch; the bench can leave it on and switch the supply. Throttle positions are full throttle (yes), neutral and full brake (no), so the signal needs three positions.",
  "scheme": {
    "type": "yes_no",
    "entry": {
      "throttle": "max",
      "when": "before_power_on",
      "hold_ms": null,
      "confirm_signal": "One ring, a few seconds later 4 rings (calibration ready), a few seconds later 4 rings (programming mode)",
      "steps": [
        "Plug in the battery, hold full throttle",
        "Switch the ESC on: 1 ring",
        "Wait a few seconds: 4 rings (calibration)",
        "Keep holding full throttle, wait a few seconds more: 4 rings = programming mode",
        "Let the trigger go to neutral"
      ]
    },
    "announce": {
      "what": "item_then_value",
      "encoding": "count",
      "long_equals_short": null,
      "beep_ms": null,
      "gap_ms": null,
      "group_gap_ms": null,
      "repeat": null,
      "description": "Each question is two beep groups: the first group is the setting number, the second is the value number, for example Beep-Pause-Beep for setting 1 value 1. The ESC asks values one at a time."
    },
    "select": {
      "throttle": "max",
      "within_ms": 3000,
      "description": "Answer yes: hold full throttle for about 3000 ms until a confirmation tone sounds, then release to neutral. Answer no: hold full brake for about 3000 ms, then release. A yes stores that value and skips to the next setting; a no moves to the next value. No on all values keeps the stored value."
    },
    "skip": {
      "throttle": "min",
      "description": "No (full brake, about 3000 ms) moves to the next value of the same setting."
    },
    "confirm_signal": "A beeping tone after each answer is accepted; then release to neutral.",
    "exit": "Disconnect power at any time; settings already answered are kept.",
    "changes_per_entry": "many",
    "reset_to_defaults": null,
    "description": "Hold full throttle at power-on to reach programming mode. The ESC beeps setting number then value number. Answer yes with full throttle or no with full brake, held about 3 s; a confirmation tone follows; release to neutral for the next question."
  },
