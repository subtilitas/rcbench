  "automatable": "assisted",
  "automatable_note": "The stick menu shows mode and value by LED flash counts (yellow LED = mode, red LED = value). Beeps only confirm (5 on entry, 2 on a mode change, 3 on store). The bench cannot read the LEDs, so the current mode and value are not observable from supply current.",
  "scheme": {
    "type": "count",
    "entry": {
      "throttle": "max",
      "when": "after_power_on",
      "hold_ms": 6000,
      "confirm_signal": "Five beeps after the stick returns to full throttle and is held at least 6 s.",
      "steps": [
        "Calibrate the stick range as described (full throttle, melody at about 10 s, motor off within 4 s, melody) up to step 4 or 5.",
        "Move the stick to full throttle again and hold it for at least 6 s.",
        "Five beeps: programming mode."
      ]
    },
    "announce": {
      "what": "item_then_value",
      "encoding": "count",
      "long_equals_short": null,
      "beep_ms": null,
      "gap_ms": null,
      "group_gap_ms": null,
      "repeat": null,
      "description": "LED flashes, not beeps: the yellow LED flashes the mode number (1-5), the red LED flashes the value number (1-11). Beeps are confirmations only."
    },
    "select": {
      "throttle": "min",
      "within_ms": null,
      "description": "Move the stick to stop/reverse and back to full throttle to step to the next mode (2 beeps confirm). With the wanted mode shown, hold stop/reverse for 2 s; then each full-throttle move raises the value by one. Hold full throttle at least 2 s to store (3 beeps)."
    },
    "skip": {
      "throttle": "none",
      "description": "Pass a mode by one stop/reverse-then-full move."
    },
    "confirm_signal": "Three beeps after a stored value; two beeps after a mode change; five beeps on entry.",
    "exit": "Disconnect the power supply to store the settings.",
    "changes_per_entry": "many",
    "reset_to_defaults": "Mode 6 value 2 (yes) is factory reset; Mode 5 on controllers without sensor connection.",
    "description": "After calibrating the stick range, hold full throttle for 6 s for five beeps. Stop then full steps the mode (yellow LED count, 2 beeps). Stop for 2 s opens the values. Each stop-to-full move raises the value (red LED count). Full throttle for 2 s stores it (3 beeps). Disconnect power to finish."
  },
