  "scheme": {
    "type": "short_long",
    "entry": {
      "throttle": "max",
      "when": "before_power_on",
      "hold_ms": null,
      "confirm_signal": "Two short tones, then the tone series of the first parameter.",
      "steps": [
        "Transmitter on with throttle at full.",
        "Connect the battery: three ascending tones, then two short tones (full throttle accepted).",
        "Keep full throttle for more than 5 s (do not lower the stick): the ESC plays another tone series and enters programming.",
        "Two short tones, then the tones of parameter 1."
      ]
    },
    "announce": {
      "what": "item_then_value",
      "encoding": "short_long",
      "long_equals_short": 5,
      "beep_ms": null,
      "gap_ms": null,
      "group_gap_ms": null,
      "repeat": null,
      "description": "Parameters sound as tones: 1-4 short tones = parameter 1-4; one long = 5; long plus 1-4 short = 6-9; two long = 10; two long plus 1-2 short = 11-12. Options of a selected parameter sound with the same code (option N = same tones as parameter N)."
    },
    "select": {
      "throttle": "min",
      "within_ms": 3000,
      "description": "Select a parameter by moving the stick to the bottom position within 3 s of its tones. Choose an option by moving the stick to full throttle during its tones."
    },
    "skip": {
      "throttle": "none",
      "description": "Do not move the stick within 3 s: the ESC goes on to the next parameter. If nothing is selected the list repeats."
    },
    "confirm_signal": "After a selection the ESC continues down the parameter list; no separate stored-tone is named.",
    "exit": "Not clear: the text says select the last parameter (#13); the list has 15 parameters and no exit entry. Power cycle is the fallback.",
    "changes_per_entry": "many",
    "reset_to_defaults": "Parameter 12 (two long, two short tones): factory reset.",
    "description": "Full throttle at power-up for more than 5 s after the two acceptance tones enters programming. Parameters sound as short and long tones; bottom stick within 3 s selects one, full throttle selects an option. The manual says to select the last parameter to save and exit, but its parameter list has no exit item."
  },
