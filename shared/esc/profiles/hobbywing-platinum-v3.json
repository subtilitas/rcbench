  "scheme": {
    "type": "short_long",
    "entry": {
      "throttle": "max",
      "when": "before_power_on",
      "hold_ms": 7000,
      "confirm_signal": "Two short beeps about 2 s after power-up, then a special tone about 5 s later (written as 56712 or a rising tone in the manuals)",
      "steps": [
        "Transmitter on, throttle at max",
        "Connect battery",
        "Wait about 2000 ms: two short beeps",
        "Wait about 5000 ms more: special tone, programming mode entered"
      ]
    },
    "announce": {
      "what": "item_then_value",
      "encoding": "short_long",
      "long_equals_short": 5,
      "beep_ms": null,
      "gap_ms": null,
      "group_gap_ms": null,
      "repeat": null,
      "description": "12 item tones loop: items 1-4 are 1-4 short beeps, item 5 is 1 long, 6-9 are 1 long plus 1-4 short, item 10 is 2 long, item 11 is 3 long + 1 short, item 12 is 3 long + 2 short. Value N is sounded the same way (long = 5 short)."
    },
    "select": {
      "throttle": "min",
      "within_ms": 3000,
      "description": "Item: move the throttle to min within 3000 ms after the wanted item tone."
    },
    "value_select": {
      "throttle": "max",
      "within_ms": null,
      "description": "Value: move the throttle to max while the wanted value tone sounds. The window length is not stated."
    },
    "skip": {
      "throttle": "none",
      "description": "Leave the throttle unchanged and wait for the next tone."
    },
    "confirm_signal": "Special tone (written 1515) after a value is stored.",
    "exit": "Item 12 (3 long + 2 short beeps) then throttle to min within 3000 ms; or after a stored value (tone 1515) throttle to min within 2000 ms. After a change made by stick, program card or box, the ESC emits 5 long beeps and can be restarted 5 s later.",
    "changes_per_entry": "many",
    "reset_to_defaults": "Item 11 (3 long + 1 short beeps) selects 'reset to factory default'.",
    "description": "Throttle at max, then battery on. Two short beeps after about 2 s and a special tone after about 5 s mark programming mode. The ESC loops item tones; throttle to min within 3 s of the wanted item selects it. Value tones then loop; throttle to max on the wanted tone stores it and returns to the item loop."
  },
