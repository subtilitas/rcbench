      "beep_ms": null,
      "gap_ms": null,
      "group_gap_ms": null,
      "repeat": null,
      "description": "8 item tones loop: items 1-4 are 1-4 short beeps, item 5 is 1 long, 6 is 1 long + 1 short, 7 is 1 long + 4 short as printed (see notes), 8 is 2 long. Values are 1, 2 or 3 short beeps."
    },
    "select": {
      "throttle": "min",
      "within_ms": 3000,
      "description": "Item: throttle to idle within 3000 ms after the wanted tone."
    },
    "value_select": {
      "throttle": "max",
      "within_ms": null,
      "description": "Value: throttle to full on the wanted value tone."
    },
    "skip": {
      "throttle": "none",
      "description": "Leave the throttle unchanged."
    },
    "confirm_signal": "An alternating tone after a value is stored.",
    "exit": "Item 8 (2 long beeps) then throttle to bottom within 3000 ms; or after the alternating tone throttle to bottom within 2000 ms. Holding full throttle returns to the item loop.",
    "changes_per_entry": "many",
    "reset_to_defaults": "Item 7 'Set All to Default'.",
    "description": "Throttle max, battery on, 2 beeps at 2 s, rising tone at 5 s more. Eight item tones loop; throttle to idle within 3 s selects. Value tones loop; throttle to full stores the value and an alternating tone follows; holding full returns to the items."
