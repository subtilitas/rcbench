    "type": "short_long",
    "entry": {
      "throttle": "max",
      "when": "before_power_on",
      "hold_ms": 7000,
      "confirm_signal": "2 beeps after about 2 s, a rising tone about 5 s later",
      "steps": [
        "Transmitter on, throttle at max",
        "Connect battery",
        "Wait about 2000 ms: 2 beeps",
        "Wait about 5000 ms more: rising tone, programming mode entered"
      ]
    },
    "announce": {
      "what": "item_then_value",
