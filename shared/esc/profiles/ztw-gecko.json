  "sources": [
    {
      "file": "ZTW_Gecko.pdf",
      "pages": "3-8",
      "language": "en",
      "url": "https://badasspower.com/downloads/ZTW-Gecko-Series-ESC-Manual.pdf"
    }
  ],
  "automatable": "full",
  "automatable_note": "OPTO HV models have no BEC; the manual does not say how the signal side is powered.",
  "scheme": {
    "type": "short_long",
    "entry": {
      "throttle": "max",
      "when": "before_power_on",
      "hold_ms": 2000,
      "confirm_signal": "Two short beeps after about 2 s",
      "steps": [
        "Transmitter on, throttle at max",
        "Connect battery",
        "Wait about 2000 ms: two short beeps, programming mode entered"
      ]
    },
    "announce": {
      "what": "item_then_value",
      "encoding": "short_long",
      "long_equals_short": 5,
      "beep_ms": null,
      "gap_ms": null,
      "group_gap_ms": null,
      "repeat": 4,
      "description": "10 item tones loop. Each item tone sounds 4 times. Items 1-4 are 1-4 short beeps, items 5-9 are 1 long + 0-4 short, item 10 is 2 long. Value tones follow the same coding (value 5 is 1 long)."
    },
    "select": {
      "throttle": "min",
      "within_ms": null,
      "description": "Item: throttle to min while the wanted item tone sounds; one special tone confirms the item is entered."
    },
    "value_select": {
      "throttle": "max",
      "within_ms": null,
      "description": "Value: throttle to max on the wanted value tone; one special tone confirms the value is stored."
    },
    "skip": {
      "throttle": "none",
      "description": "Wait for the next item or value tone."
    },
    "confirm_signal": "One special tone after the value is stored.",
    "exit": "Disconnect the battery; or keep waiting to pick the next item.",
    "changes_per_entry": "many",
    "reset_to_defaults": "Item 4 (4 short beeps) 'Restore factory setup defaults'.",
    "description": "Throttle max, battery on, two short beeps after 2 s. Ten item tones loop, each four times. Throttle to min on the wanted item enters it; value tones then loop; throttle to max on the wanted value stores it. Disconnect the battery to leave."
  },
