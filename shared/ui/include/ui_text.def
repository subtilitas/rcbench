UI_TEXT(BF_STOPPED_3,              59, "Take a photo of this screen and report the fault.")
UI_TEXT(BF_SILENT_MEANS,           61, "No response on the bus. The two boards cannot communicate.")
UI_TEXT(BF_CORRUPT_MEANS,           0, "Frames arrive with changed data. Check the wiring and bit timing.")
UI_TEXT(BF_LOSSY_MEANS,            61, "Some frames are lost, and the bus reports errors.")
UI_TEXT(BF_DROPPED_MEANS,          61, "Frames arrived intact, then were discarded unread. Not a wiring fault.")
UI_TEXT(BF_SILENT_1,               59, "Check the coprocessor's power LED, not the panel's.")
UI_TEXT(BF_SILENT_2,               59, "Connect CANH to CANH and CANL to CANL. Do not cross them.")
UI_TEXT(BF_SILENT_3,               59, "Both boards must use firmware from the same release.")
UI_TEXT(BF_SILENT_4,               59, "With the bench off, measure about 60 ohms")
UI_TEXT(BF_SILENT_5,               59, "`  between CANH and CANL for correct termination.`")
UI_TEXT(BF_CORRUPT_1,               0, "With the bench off, expect about 60 ohms between CANH and CANL.")
UI_TEXT(BF_CORRUPT_2,               0, "`  A reading of 120 ohms means one terminator is missing.`")
UI_TEXT(BF_CORRUPT_3,               0, "Keep the branch to each board under 30 cm.")
UI_TEXT(BF_TWISTED,                 0, "Twist CANH and CANL together. Keep them away from motor wires.")
UI_TEXT(BF_LOSSY_1,                59, "With the bench off, check for about 60 ohms between CANH and CANL.")
UI_TEXT(BF_LOSSY_2,                59, "Keep the total bus below 5 m and each branch below 30 cm.")
UI_TEXT(BF_LOSSY_4,                59, "Check that every connector is fully seated.")
UI_TEXT(BF_DROPPED_1,              59, "The wiring is not the cause. The frames arrived intact.")
UI_TEXT(BF_DROPPED_2,              59, "Frames were not read in time. Please report this fault")
