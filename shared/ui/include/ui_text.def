UI_TEXT(PG_HELP_DIRECTION,         96, "Sets the direction of rotation and whether reverse is allowed.")
UI_TEXT(PG_HELP_TIMING_STEPS,      96, "Sets how early the ESC commutates. Higher timing suits high-kV motors.")
UI_TEXT(PG_HELP_PWM,               96, "Higher: quieter, but warmer. Lower: more efficient, but audible.")
UI_TEXT(PG_HELP_STARTUP,           96, "Sets the starting power before the ESC can detect the rotor position.")
UI_TEXT(PG_HELP_DEMAG,             96, "Reduces power if the magnetic field decays too slowly. Helps prevent stalls under load.")
UI_TEXT(PG_HELP_BRAKE,             96, "Holds the motor still at zero throttle instead of letting it spin freely.")
UI_TEXT(PG_HELP_LVC,               96, "Cell voltage at which power is reduced to protect the battery.")
UI_TEXT(PG_HELP_BEEP,              96, "Sets the volume of startup tones and the signal-loss beep.")
UI_TEXT(PG_HELP_TIMING_DEG,        96, "Timing in degrees ahead of the rotor. More: higher speed and heat. Less: cooler.")
UI_TEXT(PG_HELP_SINE,              96, "Uses a sine wave at low speed, until the ESC can detect the rotor position.")
UI_TEXT(PG_HELP_COMPLEMENTARY,     96, "Drives both sides of the bridge. Runs cooler, but needs correct timing.")
UI_TEXT(PG_HELP_TELEMETRY,         96, "Sends voltage, current and speed back over the signal wire.")
UI_TEXT(PG_HELP_MOTOR_TYPE,        96, "Selects six-step commutation or field-oriented control.")
UI_TEXT(PG_HELP_CURRENT,           96, "Limits the current through the motor, regardless of the requested power.")
UI_TEXT(PG_HELP_REGEN,             96, "Feeds braking energy back into the battery instead of the motor.")
UI_TEXT(PG_HELP_CENTRE,            96, "Sets neutral in microseconds relative to 1500.")
UI_TEXT(PG_HELP_ENDPOINT,          96, "Limits travel in each direction from the centre.")
UI_TEXT(PG_HELP_HORN,              96, "Sets which way the servo horn moves as the pulse gets longer.")
UI_TEXT(PG_HELP_SPEED,             96, "Slows the servo horn for scale models and gentle linkage movement.")
UI_TEXT(PG_HELP_DEADBAND,          96, "Sets how much position error is allowed before correcting. A wider dead band runs cooler.")
UI_TEXT(PG_HELP_RESOLUTION,        96, "Sets how finely the commanded position is resolved.")
UI_TEXT(PG_HELP_OVERLOAD,          96, "The servo reduces power if it stays blocked for too long. This helps prevent overheating.")
UI_TEXT(PG_HELP_FAILSAFE,          96, "Moves to a set position when the signal stops, instead of releasing the servo.")
UI_TEXT(PG_TRANSPORT_ONEWIRE,       0, "one-wire bootloader, 19200 baud")
