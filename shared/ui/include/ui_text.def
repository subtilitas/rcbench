/* ----------------------------------------------------------- bus fault */
UI_TEXT(BF_BUS_OFF_TEXT,           29, "this panel is off the bus")
UI_TEXT(BF_BUS_REJOIN_TEXT,        29, "this panel is rejoining")
UI_TEXT(BF_BUS_STOPPED_TEXT,       29, "the controller has stopped")
UI_TEXT(BF_BUS_RUNNING_TEXT,       29, "the link stopped answering")
UI_TEXT(BF_BUS_UNKNOWN_TEXT,       29, "the controller cannot be read")
UI_TEXT(BF_BUS_REJOIN_WORD,        33, "rejoining")
UI_TEXT(BF_BUS_STOPPED_WORD,       33, "stopped")
UI_TEXT(BF_BUS_RUNNING_WORD,       33, "running")
UI_TEXT(BF_BUS_UNKNOWN_WORD,       33, "not running")
UI_TEXT(BF_BUS_OFF_MEANS,          61, "Too many frames went unacknowledged. It stopped transmitting.")
UI_TEXT(BF_BUS_REJOIN_MEANS,       61, "It is counting the quiet time a rejoin needs. Give it 3 s.")
UI_TEXT(BF_BUS_STOPPED_MEANS,      61, "It is idle and was not restarted. That is a fault in here.")
UI_TEXT(BF_BUS_RUNNING_MEANS,      61, "The controller is on the bus and nothing answers its frames.")
UI_TEXT(BF_BUS_UNKNOWN_MEANS,      61, "The driver is not running, so nothing can be sent at all.")
UI_TEXT(BF_REJOIN_1,               59, "The panel is asking for the bus back, once a second.")
UI_TEXT(BF_REJOIN_2,               59, "If this clears on its own, nothing here is broken.")
UI_TEXT(BF_REJOIN_3,               59, "If it stays, photograph this screen and report it.")
UI_TEXT(BF_RUNNING_1,              59, "Is the coprocessor still powered? Its own LED.")
UI_TEXT(BF_RUNNING_2,              59, "A connector only nearly seated behaves exactly like this.")
UI_TEXT(BF_RUNNING_3,              59, "Photograph this screen if both look right.")
UI_TEXT(BF_STOPPED_1,              59, "Nothing on the bench causes this. It is a fault in the")
UI_TEXT(BF_STOPPED_2,              59, "  panel's own firmware.")
UI_TEXT(BF_STOPPED_3,              59, "Photograph this screen and report it.")
UI_TEXT(BF_SILENT_MEANS,           61, "Nothing answered on the bus. The two boards are not talking.")
UI_TEXT(BF_CORRUPT_MEANS,           0, "Frames cross and arrive changed. The wire or the bit timing.")
UI_TEXT(BF_LOSSY_MEANS,            61, "Frames cross, some are lost, and the bus reported errors.")
UI_TEXT(BF_DROPPED_MEANS,          61, "Frames arrived intact and were dropped unread. Not the wire.")
UI_TEXT(BF_SILENT_1,               59, "Is the coprocessor powered? Its own LED, not the panel's.")
UI_TEXT(BF_SILENT_2,               59, "CANH to CANH and CANL to CANL, not crossed.")
UI_TEXT(BF_SILENT_3,               59, "Both boards flashed from the same release.")
UI_TEXT(BF_SILENT_4,               59, "Terminators: about 60 ohms across CANH and CANL,")
UI_TEXT(BF_SILENT_5,               59, "  measured with the bench switched off.")
UI_TEXT(BF_CORRUPT_1,               0, "Terminators: about 60 ohms across CANH and CANL with the")
UI_TEXT(BF_CORRUPT_2,               0, "  bench off. 120 ohms means one of the two is missing.")
UI_TEXT(BF_CORRUPT_3,               0, "Keep the branch to each board under 30 cm.")
UI_TEXT(BF_TWISTED,                 0, "CANH and CANL twisted together, away from motor leads.")
UI_TEXT(BF_LOSSY_1,                59, "Terminators: about 60 ohms across CANH and CANL, bench off.")
UI_TEXT(BF_LOSSY_2,                59, "Total bus under 5 m, and each branch under 30 cm.")
UI_TEXT(BF_LOSSY_4,                59, "A connector that is only nearly seated behaves like this.")
UI_TEXT(BF_DROPPED_1,              59, "The wiring is not the fault: the frames arrived intact.")
UI_TEXT(BF_DROPPED_2,              59, "Something stopped reading them in time. Please report this")
