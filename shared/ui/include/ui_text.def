UI_TEXT(PG_HELP_DIRECTION,         96, "Which way it turns, and whether reverse is allowed at all")
UI_TEXT(PG_HELP_TIMING_STEPS,      96, "How far ahead of the rotor the drive commutates: more suits high kV")
UI_TEXT(PG_HELP_PWM,               96, "Higher is quieter and warmer; lower is efficient and audible")
UI_TEXT(PG_HELP_STARTUP,           96, "How hard it pushes to get moving before it can sense the rotor")
UI_TEXT(PG_HELP_DEMAG,             96, "Backs off when the field collapses late: cures stalls under load")
UI_TEXT(PG_HELP_BRAKE,             96, "Holds the motor still at zero throttle instead of letting it freewheel")
UI_TEXT(PG_HELP_LVC,               96, "Per cell, where it starts pulling power back to save the pack")
UI_TEXT(PG_HELP_BEEP,              96, "How loud the startup tones and the lost-signal beep are")
UI_TEXT(PG_HELP_TIMING_DEG,        96, "Degrees ahead of the rotor: more rpm and more heat, less is cooler")
UI_TEXT(PG_HELP_SINE,              96, "Drives a smooth wave until it has enough speed to sense the rotor")
UI_TEXT(PG_HELP_COMPLEMENTARY,     96, "Drives both halves of the bridge: cooler, but needs healthy timing")
UI_TEXT(PG_HELP_TELEMETRY,         96, "Sends volts, amps and rpm back down the signal wire")
UI_TEXT(PG_HELP_MOTOR_TYPE,        96, "Six-step commutation, or field-oriented control")
UI_TEXT(PG_HELP_CURRENT,           96, "The most it will draw through the motor, whatever is asked of it")
UI_TEXT(PG_HELP_REGEN,             96, "Puts braking energy back into the pack rather than into the motor")
UI_TEXT(PG_HELP_CENTRE,            96, "Where neutral sits, in microseconds either side of 1500")
UI_TEXT(PG_HELP_ENDPOINT,          96, "How far it is allowed to go each way from centre")
UI_TEXT(PG_HELP_HORN,              96, "Which way the horn moves for a rising pulse")
UI_TEXT(PG_HELP_SPEED,             96, "Slews the horn deliberately, for scale models and gentle linkages")
UI_TEXT(PG_HELP_DEADBAND,          96, "How far off target it tolerates before correcting: wider runs cooler")
UI_TEXT(PG_HELP_RESOLUTION,        96, "How finely it resolves the commanded position")
UI_TEXT(PG_HELP_OVERLOAD,          96, "Backs off when it has been stalled long enough to cook itself")
UI_TEXT(PG_HELP_FAILSAFE,          96, "Goes to a set position when the pulse stops, rather than going limp")
UI_TEXT(PG_TRANSPORT_ONEWIRE,       0, "one-wire bootloader, 19200 baud")
