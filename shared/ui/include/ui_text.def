/*
 * Every translated string of the interface: its ID, the cells it may take
 * where it is drawn, and its English.  Included by ui_text.h for the IDs and
 * by ui_text.c for the English table; ui_text_de.c holds the German.
 *
 * cells is the width of the field the string is drawn into, in cells of
 * its face, for a string no screenshot reaches: test_text holds every
 * language's entry to it.  0 means a rendered screen shows the string and
 * `tools/render_ui.py --fit` measures it there.  The fit check fails on an
 * ID that is neither.
 *
 * A format string's conversions are part of its contract: a translation
 * converts the same arguments in the same order (test_text checks).
 *
 * SPDX-License-Identifier: MIT
 */

/* ---------------------------------------------------------- shared words */
UI_TEXT(ON,                         0, "ON")
UI_TEXT(OFF,                        0, "OFF")
UI_TEXT(CANCEL,                     0, "CANCEL")
UI_TEXT(SPACE,                      0, "SPACE")

/* ------------------------------------------------------------ the band */
UI_TEXT(BAND_SAFE,                  0, "SAFE")
UI_TEXT(BAND_FAULT,                12, "FAULT %02X")
UI_TEXT(BAND_NO_LINK,              12, "NO LINK")
UI_TEXT(LINK_REFUSED,               0, "Rejected link frames: %lu")

/* --------------------------------------------- the band's help bubbles
 * A tap on a chip of the band opens one.  Each is wrapped to the bubble's
 * width, so a view draws it and --fit measures it there; test_nav holds
 * the bubble above the alert strip in its tallest state. */
UI_TEXT(BH_LINK_UP,                 0, "The coprocessor is responding on the CAN bus. The screens control its outputs and show its readings. The panel requests data every 50 ms. If the coprocessor stops responding while ARMED, the bench switches to SAFE.")
UI_TEXT(BH_NO_LINK,                 0, "No coprocessor is responding. The panel tries once a second. The screens show simulated data, and the coprocessor outputs stay off. Check the coprocessor's power supply and CAN cable. A different major protocol version also causes NO LINK. Install firmware from the same release on both boards.")
UI_TEXT(BH_MODE_BENCH,              0, "The coprocessor is responding. The screens control its outputs and show its data. If it stops responding, the mode changes to SIM.")
UI_TEXT(BH_MODE_SIM,                0, "No coprocessor is responding. The panel simulates the values; they are not measurements. ARM does not activate any output. When a coprocessor responds, the mode changes to BENCH and any simulated ARMED state resets to SAFE.")
/* INJECT's two paragraphs: in a build with RCBENCH_TOUCH_INJECTOR only, so
 * the released image holds neither.  The host suite and render_ui.py build
 * with it.  The define rides with this header's include path (shared/ui's
 * CMakeLists.txt), so every file that sees the IDs sees the same set. */
#ifdef RCBENCH_TOUCH_INJECTOR
UI_TEXT(BH_MODE_INJECT,             0, "This is a test-bench build, not a release version. Touch input also comes from the injector at I2C address 0x14. It is combined with input from the panel touchscreen, which still works. LINK shows whether a coprocessor responds. The older of the two sources determines the touch age. A contact on the touchscreen counts as detected touch. Without a controller at 0x5D, the status always shows INJECT. If the injector was absent at startup, a restart is needed.")
UI_TEXT(BH_MODE_INJECT_LOST,        0, "With a controller at 0x5D, injector contacts are released after 3 failed reads in a row. If the touchscreen has no contact, touch is marked silent 200 ms after the injector's last reply. After another 500 ms, the bench switches to SAFE and blocks ARM. After 1000 ms of silence, the injector is detached. The touchscreen alone then sets the touch age, ARM is available again, and the status shows BENCH or SIM. The injector is checked every 1000 ms and reconnected when it replies.")
#endif
UI_TEXT(BH_SAFE,                    0, "Motor and servo outputs send no pulses. To activate them, hold ARM for 2 s on MOTOR & ESC or SERVO. The PD mini output on SUPPLY is switched separately. STOP turns it off too.")
UI_TEXT(BH_ARMED_MOTOR,             0, "Motor outputs send pulses. Servo outputs do not.")
UI_TEXT(BH_ARMED_SERVO,             0, "Servo outputs send pulses. Motor outputs do not.")
UI_TEXT(BH_ARMED_ALL,               0, "All assigned motor and servo outputs send pulses.")
UI_TEXT(BH_ARMED_REST,              0, "A channel with no command for 500 ms returns to rest: throttle at 0, servo at the centre of its travel. STOP, DISARM or leaving the screen switches the bench to SAFE.")
UI_TEXT(BH_ARMED_SIM,               0, "No coprocessor is responding. ARM runs the panel's simulation, not real outputs.")
UI_TEXT(BH_CLOCK,                   0, "Shows the run time since switching to ARMED. At SAFE, the clock stops and keeps the last run time until the next ARM. It shows minutes and seconds, adding hours from 60 min.")
UI_TEXT(BH_F_LINK_SILENT,           0, "The coprocessor received no data for 200 ms and switched itself to SAFE. The PD mini output is off. A panel restart or loose CAN cable can cause this. The fault bit stays set until the next ARM. If it returns, check the CAN cable.")
UI_TEXT(BH_F_OVERCURRENT,           0, "Stopped due to overcurrent.")
UI_TEXT(BH_F_OVERTEMP,              0, "Stopped due to overheating.")
UI_TEXT(BH_F_STALL,                 0, "Stopped because the motor stalled.")
UI_TEXT(BH_F_HEARTBEAT,             0, "The safety signal from the panel to the coprocessor has stopped. After any stop, the panel keeps it stopped until the next ARM. Otherwise, the emergency stop is pressed or the heartbeat wire is open. The coprocessor is SAFE and blocks ARMED. The PD mini output is off. Release the emergency stop or check the wire, then hold ARM.")
UI_TEXT(BH_F_VERSION,               0, "The versions on the two devices do not match.")
UI_TEXT(BH_F_STORE_OFF,             0, "The coprocessor cannot write flash during this boot. Sent settings work from RAM but are lost at restart. Restart it to try again. Whether that clears the fault bit has not been tested.")
UI_TEXT(BH_F_NEVER,                 0, "This release never sets this bit.")
UI_TEXT(BH_F_OTHER,                 0, "Other bits (%04X) are unknown to this panel.")
UI_TEXT(BH_F_FLASH,                 0, "If a bit appears that this release never sets, install firmware from the same release on both boards.")

