UI_TEXT(SP_HAND_ASKS, 0,
    "Each manual step is shown when needed. The run waits for DONE.",
    "Jeder Handgriff wird zur passenden Zeit angezeigt. Der Lauf wartet auf ERLEDIGT.")
UI_TEXT(SP_HAND_NOT_RUN, 70,
    "The bench cannot run this profile: %s.",
    "Der Prüfstand kann dieses Profil nicht ausführen: %s.")
