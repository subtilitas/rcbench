UI_TEXT(BF_BUS_OFF_TEXT, 0,
    "Panel disconnected from the bus.",
    "Panel vom Bus getrennt.")
UI_TEXT(BF_BUS_REJOIN_TEXT, 0,
    "Panel is reconnecting.",
    "Panel verbindet sich neu.")
UI_TEXT(BF_BUS_STOPPED_TEXT, 0,
    "The panel's CAN controller has stopped.",
    "CAN-Controller des Panels ist gestoppt.")
UI_TEXT(BF_BUS_RUNNING_TEXT, 0,
    "The link stopped responding.",
    "Verbindung antwortet nicht mehr.")
UI_TEXT(BF_BUS_UNKNOWN_TEXT, 0,
    "Cannot read the controller's state.",
    "Controller-Zustand nicht auslesbar.")
UI_TEXT(BF_BUS_REJOIN_WORD, 0,
    "reconnecting",
    "verbindet sich neu")
UI_TEXT(BF_BUS_STOPPED_WORD, 0,
    "stopped",
    "gestoppt")
UI_TEXT(BF_BUS_RUNNING_WORD, 0,
    "running",
    "läuft")
UI_TEXT(BF_BUS_UNKNOWN_WORD, 0,
    "not running",
    "läuft nicht")
UI_TEXT(BF_BUS_OFF_MEANS, 0,
    "Too many frames were not confirmed. The controller stopped sending.",
    "Zu viele Frames blieben unbestätigt. Der Controller sendet nicht mehr.")
UI_TEXT(BF_BUS_REJOIN_MEANS, 0,
    "The controller is waiting for the bus to be quiet before reconnecting. Wait 3s.",
    "Der Controller wartet vor dem Neuverbinden auf Busruhe. Warte 3s.")
UI_TEXT(BF_BUS_STOPPED_MEANS, 0,
    "The controller stopped and was not restarted. This is a fault in the panel.",
    "Der Controller wurde nach dem Stopp nicht neu gestartet. Das ist ein Fehler im Panel.")
UI_TEXT(BF_BUS_RUNNING_MEANS, 0,
    "The controller is connected to the bus, but no device confirms its frames.",
    "Der Controller ist am Bus, aber kein Gerät bestätigt seine Frames.")
UI_TEXT(BF_BUS_UNKNOWN_MEANS, 0,
    "The driver is not running. No data can be sent.",
    "Der Treiber läuft nicht. Es können keine Daten gesendet werden.")
UI_TEXT(BF_REJOIN_1, 0,
    "The panel tries to reconnect once a second.",
    "Das Panel versucht jede Sekunde, sich neu zu verbinden.")
UI_TEXT(BF_REJOIN_2, 0,
    "If the connection returns on its own, this is not a defect.",
    "Kommt die Verbindung von selbst zurück, liegt kein Defekt vor.")
UI_TEXT(BF_REJOIN_3, 0,
    "If the problem remains, take a photo of this screen and report it.",
    "Bleibt das Problem, fotografiere diese Seite und melde den Fehler.")
UI_TEXT(BF_RUNNING_1, 0,
    "Check the IOmcu's power LED. Is it still powered?",
    "Prüfe die LED am IOmcu. Hat er noch Strom?")
UI_TEXT(BF_RUNNING_2, 0,
    "Check that every connector is fully seated.",
    "Prüfe, ob alle Stecker richtig sitzen.")
UI_TEXT(BF_RUNNING_3, 0,
    "If both are OK, take a photo of this screen.",
    "Ist beides in Ordnung, fotografiere diese Seite.")
UI_TEXT(BF_STOPPED_1, 0,
    "This is a fault in the panel's firmware,",
    "Der Fehler liegt in der Firmware des Panels,")
UI_TEXT(BF_STOPPED_2, 0,
    "  not in the connected bench hardware.",
    "  nicht an der angeschlossenen Prüfstand-Hardware.")
UI_TEXT(BF_STOPPED_3, 0,
    "Take a photo of this screen and report the fault.",
    "Fotografiere diese Seite und melde den Fehler.")
UI_TEXT(BF_SILENT_MEANS, 0,
    "No response on the bus. The two boards cannot communicate.",
    "Keine Antwort am Bus. Die beiden Platinen können keine Daten austauschen.")
UI_TEXT(BF_CORRUPT_MEANS, 0,
    "Frames arrive with changed data. Check the wiring and bit timing.",
    "Frames kommen mit veränderten Daten an. Prüfe Verkabelung und Bit-Timing.")
UI_TEXT(BF_LOSSY_MEANS, 0,
    "Some frames are lost, and the bus reports errors.",
    "Einige Frames gehen verloren. Der Bus meldet Fehler.")
UI_TEXT(BF_DROPPED_MEANS, 0,
    "Frames arrived intact, then were discarded unread. Not a wiring fault.",
    "Frames kamen korrekt an, wurden aber ungelesen verworfen. Kein Verkabelungsfehler.")
UI_TEXT(BF_SILENT_1, 0,
    "Check the IOmcu's power LED, not the panel's.",
    "Prüfe die Versorgungs-LED am IOmcu, nicht die am Panel.")
UI_TEXT(BF_SILENT_2, 0,
    "Connect CANH to CANH and CANL to CANL. Do not cross them.",
    "Verbinde CANH mit CANH und CANL mit CANL. Vertausche sie nicht.")
UI_TEXT(BF_SILENT_3, 0,
    "Both boards must use firmware from the same release.",
    "Beide Platinen müssen Firmware aus demselben Release nutzen.")
UI_TEXT(BF_SILENT_4, 0,
    "With the bench off, measure about 60Ω",
    "Miss bei ausgeschaltetem Prüfstand den Widerstand")
UI_TEXT(BF_SILENT_5, 0,
    "  between CANH and CANL for correct termination.",
    "  zwischen CANH und CANL. Etwa 60Ω sind richtig.")
UI_TEXT(BF_CORRUPT_1, 0,
    "With the bench off, expect about 60Ω between CANH and CANL.",
    "Schalte den Prüfstand aus. Prüfe auf etwa 60Ω zwischen CANH und CANL.")
UI_TEXT(BF_CORRUPT_2, 0,
    "  A reading of 120Ω means one terminator is missing.",
    "  Bei 120Ω fehlt einer der beiden Abschlusswiderstände.")
UI_TEXT(BF_CORRUPT_3, 0,
    "Keep the branch to each board under 30cm.",
    "Halte die Stichleitung zu jeder Platine unter 30cm.")
UI_TEXT(BF_TWISTED, 0,
    "Twist CANH and CANL together. Keep them away from motor wires.",
    "Verdrille CANH und CANL. Halte Abstand zu Motorleitungen.")
UI_TEXT(BF_LOSSY_1, 0,
    "With the bench off, check for about 60Ω between CANH and CANL.",
    "Schalte den Prüfstand aus. Prüfe auf etwa 60Ω zwischen CANH und CANL.")
UI_TEXT(BF_LOSSY_2, 0,
    "Keep the total bus below 5m and each branch below 30cm.",
    "Halte den gesamten Bus unter 5m und jede Stichleitung unter 30cm.")
UI_TEXT(BF_LOSSY_4, 0,
    "Check that every connector is fully seated.",
    "Prüfe, ob alle Stecker richtig sitzen.")
UI_TEXT(BF_DROPPED_1, 0,
    "The wiring is not the cause. The frames arrived intact.",
    "Die Verkabelung ist nicht die Ursache. Die Frames kamen korrekt an.")
UI_TEXT(BF_DROPPED_2, 0,
    "Frames were not read in time. Please report this fault",
    "Frames wurden nicht rechtzeitig gelesen. Melde diesen Fehler")
UI_TEXT(BF_DROPPED_3, 0,
    "  and include the numbers shown on the right.",
    "  mit den Zahlen auf der rechten Seite.")
UI_TEXT(BF_HEAD_MEANS, 0,
