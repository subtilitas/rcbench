UI_TEXT(KP_M_UNKNOWN_CODE, 116,
    "The IOmcu reports code %u. This panel does not recognise it.",
    "IOmcu meldet Code %u. Dieses Panel kennt ihn nicht.")
UI_TEXT(KP_O_DROPPED, 116,
    "Connection lost during the operation. Tap READ ALL.",
    "Verbindung während des Vorgangs verloren. Tippe auf ALLES AUSLESEN.")
UI_TEXT(KP_R_BUSY, 116,
    "Port busy. Try again.",
    "Port belegt. Versuche es erneut.")
UI_TEXT(KP_R_PORT, 116,
    "This programming port does not exist on the IOmcu.",
    "Diesen Programmierport gibt es auf dem IOmcu nicht.")
UI_TEXT(KP_R_NO_PIN, 116,
    "No pin assigned to the programming port. Nothing sent.",
    "Dem Programmierport ist kein Pin zugeordnet. Nichts gesendet.")
UI_TEXT(KP_R_SUPPLY_RANGE, 116,
