UI_TEXT(KP_S_NOT_IN_MODE, 116,
    "Servo not in programming mode. Tap LEAVE, then CONNECT.",
    "Servo nicht im Programmiermodus. Tippe auf VERLASSEN, dann auf VERBINDEN.")
UI_TEXT(KP_S_READ, 116,
    "Could not read the servo. Check the plug, then tap READ ALL.",
    "Servo konnte nicht ausgelesen werden. Prüfe den Stecker, dann tippe auf ALLES AUSLESEN.")
UI_TEXT(KP_S_NO_BACKUP, 116,
