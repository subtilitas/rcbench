/* ------------------------------------------------------- the guide */
/* The dock of the screen guide (ui_help.h): its web line, the line that
 * opens its first page while ARMED left pages out, and each screen's
 * pages.  An item's text follows its label and two spaces in rows of 41
 * cells, 3 rows at most (test_help_pages). */
UI_TEXT(HG_WEB, 44,
    "More: subtilitas.github.io/rcbench/help/",
    "Mehr: subtilitas.github.io/rcbench/help/de/")
UI_TEXT(HG_ARMED_NOTE, 44,
    "ARMED: only pages that hide no live control",
    "ARMED: nur Seiten ohne verdeckte Bedienung")
/* The menu's three pages. */
UI_TEXT(HG_OV_TITLE_LEFT, 0,
    "MENU: LEFT TILES",
    "MENÜ: LINKE KACHELN")
UI_TEXT(HG_OV_TITLE_RIGHT, 0,
    "MENU: RIGHT TILES",
    "MENÜ: RECHTE KACHELN")
UI_TEXT(HG_OV_TITLE_BAND, 0,
    "MENU: BAND AND MARK",
    "MENÜ: BAND UND MARKE")
UI_TEXT(HG_OV_MOTOR, 0,
    "Drives an ESC and records voltage, current, power and rpm. PROGRAM sets up the ESC.",
    "Steuert den ESC, zeichnet Spannung, Strom, Leistung und Drehzahl auf. PROGRAMMIEREN stellt ihn ein.")
UI_TEXT(HG_OV_SERVO, 0,
    "Drives a servo and measures its current. TEST runs the automatic test, PROGRAM programs the servo.",
    "Steuert ein Servo und misst den Strom. TEST startet den Servotest, PROGRAMMIEREN die Servoprogrammierung.")
UI_TEXT(HG_OV_SUPPLY, 0,
    "Sets and switches the PD mini supply and records its voltage and current.",
    "Stellt und schaltet das PD-mini-Netzteil und zeichnet Spannung und Strom auf.")
UI_TEXT(HG_OV_RECEIVER, 0,
    "Shows what a receiver sends on S.BUS: 16 channels, the frame rate and the decoder's counters.",
    "Zeigt S.BUS-Daten eines Empfängers: 16 Kanäle, Frames pro Sekunde und die Zähler des Decoders.")
UI_TEXT(HG_OV_BATTERY, 0,
    "Shows how far each cell differs from the pack's average, and a verdict on the pack.",
    "Zeigt die Abweichung jeder Zelle vom Mittelwert des Akkus und bewertet den Akku.")
UI_TEXT(HG_OV_BALANCE, 0,
    "Finds where a propeller or fan needs mass, and shows where the two sensors go.",
    "Findet, wo ein Propeller oder Lüfter Masse braucht, und zeigt, wo die zwei Sensoren sitzen.")
UI_TEXT(HG_OV_LOGS, 0,
