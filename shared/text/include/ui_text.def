UI_TEXT(HG_OV_SETUP, 0,
    "The bench-wide settings: PANEL, SENSORS, OUTPUTS, SD CARD, WI-FI and UPDATES.",
    "Die Einstellungen des ganzen Prüfstands: PANEL, SENSORS, OUTPUTS, SD CARD, WI-FI und UPDATES.")
UI_TEXT(HG_OV_STOP, 0,
