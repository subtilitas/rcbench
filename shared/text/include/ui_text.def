    "Kein Ergebnis.")
UI_TEXT(KP_O_DONE, 116,
    "Done.",
    "Fertig.")
UI_TEXT(KP_O_REFUSED, 116,
    "The IOmcu refused the request.",
    "Der IOmcu hat die Anfrage abgelehnt.")
UI_TEXT(KP_O_NACK, 116,
    "The IOmcu rejected the frame. Reason: %u.",
    "Der IOmcu hat den Frame abgelehnt. Grund: %u.")
UI_TEXT(KP_O_NO_ANSWER, 116,
    "No response from the IOmcu. Tap READ ALL.",
