UI_TEXT(KP_S_BUSY, 116,
    "An operation is running in this session.",
    "In dieser Sitzung läuft ein Vorgang.")
UI_TEXT(KP_S_ARG, 116,
    "This session rejected the request.",
    "Die Anfrage wurde in dieser Sitzung abgelehnt.")
UI_TEXT(KP_S_NO_SERVO, 116,
