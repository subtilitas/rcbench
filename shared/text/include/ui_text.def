UI_TEXT(KP_S_BAD_PLAN, 116,
    "The write plan was rejected for this session.",
    "Der Schreibplan wurde für diese Sitzung abgelehnt.")
UI_TEXT(KP_S_UNCONFIRMED, 116,
    "Restore was not confirmed.",
    "Zurückspielen wurde nicht bestätigt.")
UI_TEXT(KP_S_CHANGED, 116,
