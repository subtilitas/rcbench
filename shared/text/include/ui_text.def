UI_TEXT(ALERT_CARD_UNREADABLE, 94,
    "Cannot read the card. Run not recorded.",
    "Karte nicht lesbar. Lauf nicht aufgezeichnet.")
UI_TEXT(ALERT_CARD_FULL, 94,
    "Card full or not writable. Run not recorded.",
    "Karte voll oder nicht beschreibbar. Lauf nicht aufgezeichnet.")
