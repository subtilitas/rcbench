UI_TEXT(HP_ST_ENTRY_C, 116,
    "Power-up of the servo. Waiting for its answer.",
    "Servo wird eingeschaltet. Antwort steht aus.")
UI_TEXT(HP_ST_ENTRY_D, 116,
    "Servo starting. Frames in 1s.",
    "Servo startet. Frames in 1s.")
UI_TEXT(HP_ST_MODEL, 116,
    "Waiting 1s for the servo on its own supply.",
    "Wartezeit von 1s für das Servo mit eigener Versorgung.")
UI_TEXT(HP_ST_READ, 116,
    "Reading %u of %u.",
    "Auslesen: %u von %u.")
UI_TEXT(HP_ST_CLEARING, 116,
    "Clearing the stop on the IOmcu.",
    "Stopp wird im IOmcu aufgehoben.")
UI_TEXT(HP_ST_LEAVE_D, 116,
    "Restarting the servo. PWM follows.",
    "Servo startet neu. Danach PWM.")
UI_TEXT(HP_ST_LEAVE_C, 116,
    "Power cycle of the servo. PWM follows.",
    "Servo wird aus- und eingeschaltet. Danach PWM.")
UI_TEXT(HP_ST_RELEASING, 116,
    "Releasing the port. The tester takes it back.",
    "Port wird freigegeben. Der Tester übernimmt ihn wieder.")
UI_TEXT(HP_ST_STOPPED, 116,
    "Stopped. The pin is released. Tap CLEAR to go on, or LEAVE.",
    "Gestoppt. Der Pin ist frei. Tippe auf AUFHEBEN zum Fortsetzen oder auf VERLASSEN.")
UI_TEXT(HP_ST_STOP_LATCHED, 116,
    "Stopped. The pin is released. Hold STOP 2s to reset the STOP.",
    "Gestoppt. Der Pin ist frei. Halte STOP 2s, um den STOP zurückzusetzen.")
UI_TEXT(HP_ST_NOT_IN_MODE, 116,
    "Port %u is held. The servo is not in programming mode: LEAVE and CONNECT again.",
    "Port %u belegt. Servo nicht im Programmiermodus. Tippe auf VERLASSEN, dann auf VERBINDEN.")
UI_TEXT(HP_NO_PAGE, 116,
    "Unavailable: the IOmcu has no Hitec port.",
    "Nicht verfügbar: Der IOmcu hat keinen Hitec-Port.")
UI_TEXT(HP_NO_PAGE_2, 116,
    "Update the IOmcu to version 0.21.1 or later.",
    "Aktualisiere den IOmcu auf Version 0.21.1 oder neuer.")
UI_TEXT(HP_RX_PENDING, 116,
    "Receive mode not set on the IOmcu yet. Try again.",
    "Empfangsart im IOmcu noch nicht gesetzt. Versuche es erneut.")
UI_TEXT(HP_HELD_KST, 116,
    "The KST programmer holds this port.",
    "Die KST-Programmierung belegt diesen Port.")
UI_TEXT(HP_HELD_OTHER, 116,
    "Port held by another Hitec session.",
    "Port von einer anderen Hitec-Sitzung belegt.")
UI_TEXT(HP_RELEASE_HINT, 116,
    "RELEASE PORT (hold 2s) gives it back to the tester. The supply stays as it is.",
    "PORT FREIGEBEN (2s halten) gibt ihn an den Tester zurück. Die Versorgung bleibt unverändert.")
UI_TEXT(HP_V_CAPPED, 116,
    "Hitec programming runs at 6.0V or less.",
    "Hitec-Programmierung läuft mit höchstens 6.0V.")
UI_TEXT(HP_STOP_LATCHED, 116,
    "A STOP is latched. Hold STOP 2s to reset it.",
    "Ein STOP ist gesetzt. Halte STOP 2s, um ihn zurückzusetzen.")
UI_TEXT(HP_NOT_IN_MODE, 116,
    "The servo is not in programming mode. LEAVE and CONNECT again.",
    "Servo nicht im Programmiermodus. Tippe auf VERLASSEN, dann auf VERBINDEN.")
UI_TEXT(HP_NO_C, 116,
    "No classic servo answered after power-up. Check plug and series.",
    "Kein klassisches Servo hat nach dem Einschalten geantwortet. Prüfe Stecker und Serie.")
UI_TEXT(HP_NO_D, 116,
    "No D series servo answers. Check plug, receive mode and series.",
    "Kein Servo der D-Serie antwortet. Prüfe Stecker, Empfangsart und Serie.")
UI_TEXT(HP_NEED_PD_C, 116,
    "Classic servos need a PD mini: the bench cycles the supply.",
    "Klassische Servos brauchen ein PD mini: Der Prüfstand schaltet die Versorgung.")
UI_TEXT(HP_ENTRY_BAD, 116,
    "Unexpected reply when entering programming mode. Check the series.",
    "Unerwartete Antwort beim Einstieg in den Programmiermodus. Prüfe die Serie.")
UI_TEXT(HP_BAD_ANSWER, 116,
    "Bad answer from the servo (code %u). Reading again.",
    "Fehlerhafte Antwort vom Servo (Code %u). Werte werden erneut ausgelesen.")
UI_TEXT(HP_READ_FAIL, 116,
    "Read failed at address 0x%02X. Tap READ ALL.",
    "Auslesen bei Adresse 0x%02X fehlgeschlagen. Tippe auf ALLES AUSLESEN.")
UI_TEXT(HP_READ_D, 116,
    "D series servo, model %u, ID %u.",
    "Servo der D-Serie, Modell %u, ID %u.")
UI_TEXT(HP_READ_C, 116,
    "Classic servo %s, version 0x%02X.",
    "Klassisches Servo %s, Version 0x%02X.")
UI_TEXT(HP_ABORTED, 116,
    "The operation was aborted.",
    "Der Vorgang wurde abgebrochen.")
UI_TEXT(HP_CLEARED, 116,
    "Stop cleared on the IOmcu.",
    "Stopp im IOmcu aufgehoben.")
UI_TEXT(HP_UNSAFE, 116,
    "The IOmcu refused: its failsafe is latched.",
    "Vom IOmcu abgelehnt: Sein Failsafe ist ausgelöst.")
UI_TEXT(HP_UNSAFE_2, 116,
    "Hold ARM, then DISARM, to clear it. A held port needs LEAVE or RELEASE PORT first.",
    "Halte ARM, dann tippe auf DISARM. Gib belegte Ports vorher mit VERLASSEN oder PORT FREIGEBEN frei.")
UI_TEXT(HP_SESSION_ENDED, 116,
    "The IOmcu ended the session. The port is back in tester mode.",
    "Der IOmcu hat die Sitzung beendet. Der Port ist wieder im Testermodus.")
UI_TEXT(HP_TIMEOUT, 116,
    "No answer from the IOmcu in time. The operation ended.",
    "Keine rechtzeitige Antwort vom IOmcu. Der Vorgang ist beendet.")
UI_TEXT(HP_NO_ANSWER, 116,
    "The IOmcu reports no result for the request.",
    "Der IOmcu meldet kein Ergebnis für die Anfrage.")
UI_TEXT(HP_RESTARTED, 116,
    "The IOmcu restarted during the request.",
    "Der IOmcu wurde während der Anfrage neu gestartet.")
UI_TEXT(HP_NO_LINE, 116,
    "The IOmcu cannot drive the line of this port.",
    "Der IOmcu kann die Leitung dieses Ports nicht ansteuern.")
UI_TEXT(HP_SUPPLY, 116,
    "The supply did not execute the POWER request. Check the PD mini.",
    "Das Netzteil hat den POWER-Befehl nicht ausgeführt. Prüfe den PD mini.")
UI_TEXT(HP_REFUSED, 116,
    "The IOmcu refused the request (code %u).",
    "Der IOmcu hat die Anfrage abgelehnt (Code %u).")
UI_TEXT(HP_RELEASED, 116,
    "Port %u released. The tester uses it again.",
    "Port %u freigegeben. Der Tester nutzt ihn wieder.")
UI_TEXT(HP_RELEASED_2, 116,
    "The supply stays as it is. ARM now clears a latched failsafe.",
    "Die Versorgung bleibt unverändert. ARM hebt einen ausgelösten Failsafe jetzt auf.")
UI_TEXT(HP_LAYOUT_GUESS, 116,
    "Unknown model. Fields are interpreted as for the %s.",
    "Modell unbekannt. Die Felder werden wie beim %s interpretiert.")
UI_TEXT(HP_SUM_BAD, 116,
    "Checksum of stored values 0x00-0x1C is wrong. The servo may ignore PWM and draw current up to the supply limit.",
    "Prüfsumme für 0x00-0x1C falsch. Das Servo kann PWM ignorieren und Strom bis zur Strombegrenzung ziehen.")
UI_TEXT(HP_NOT_READ, 116,
    "Not read yet. CONNECT reads every value.",
    "Noch nicht ausgelesen. VERBINDEN liest alle Werte aus.")
UI_TEXT(HP_RAW_BESIDE, 116,
    "Stored value in brackets. RAW: a value that fits no known encoding.",
    "Gespeicherter Wert in Klammern. RAW: ein Wert, der zu keiner bekannten Codierung passt.")
UI_TEXT(HP_POS_NOTE, 116,
    "Positions in servo counts. 8192 is the centre.",
    "Positionen als Servo-Zählwerte. 8192 ist die Mitte.")
UI_TEXT(HP_DEG_NOTE, 116,
    "Degrees for a standard D servo, 220° over 16383 counts.",
    "Grad für ein Standard-D-Servo: 220° entsprechen 16383 Zählwerten.")
UI_TEXT(HP_DIR_NOTE, 116,
    "DIRECTION mirrors NEUTRAL and both ends.",
    "DREHRICHTUNG spiegelt NEUTRAL und beide Endlagen.")
UI_TEXT(HP_END_UNIT, 116,
    "LEFT END, RIGHT END: raw servo values. The unit is unknown.",
    "ENDE LINKS, ENDE RECHTS: Rohwerte des Servos. Die Einheit ist unbekannt.")
UI_TEXT(HP_RAW_NOTE, 116,
    "Registers of unknown meaning, shown raw.",
    "Register mit unbekannter Bedeutung als Rohwerte.")
UI_TEXT(HP_LEAVE_C, 116,
    "The bench switches the supply off for about 760ms and on again. The port returns to servo PWM.",
    "Der Prüfstand schaltet die Versorgung etwa 760ms aus und wieder ein. Der Port wechselt zurück zu Servo-PWM.")
UI_TEXT(HP_LEAVE_D, 116,
    "The servo restarts and ignores signals for 1s.",
    "Das Servo startet neu und ignoriert Signale 1s lang.")
UI_TEXT(HP_RELEASE_1, 116,
    "Port %u returns to the tester. The other session ends.",
    "Port %u geht an den Tester zurück. Die andere Sitzung endet.")
UI_TEXT(HP_RELEASE_2, 116,
    "The supply stays as it is.",
    "Die Versorgung bleibt unverändert.")
UI_TEXT(HP_RELEASE_3, 116,
    "Afterwards ARM clears a latched failsafe.",
    "Danach hebt ARM einen ausgelösten Failsafe auf.")
UI_TEXT(HP_REPAIR, 27,
    "REPAIR CHECKSUM",
    "PRÜFSUMME REPARIEREN")
UI_TEXT(HP_HOLD_REPAIR, 30,
    "HOLD 2s TO REPAIR",
    "2s HALTEN ZUM REPARIEREN")
UI_TEXT(HP_MORE_REPAIR, 58,
    "REPAIR CHECKSUM: write the balance in stored value 0x1C.",
    "PRÜFSUMME REPARIEREN: Schreibe den Ausgleich in 0x1C.")
UI_TEXT(HP_EDIT_NOTE, 116,
    "Tap a value to edit it. * marks a change. WRITE n VALUES on SERVO writes the changes.",
    "Tippe zum Ändern auf einen Wert. * markiert Änderungen. n WERTE SCHREIBEN auf SERVO schreibt sie.")
UI_TEXT(HP_SUM_HINT, 116,
    "MORE > REPAIR CHECKSUM writes stored value 0x1C.",
    "WEITERES > PRÜFSUMME REPARIEREN schreibt den gespeicherten Wert 0x1C.")
UI_TEXT(HP_ST_RECORD, 116,
    "Recording the values before the write on the card.",
    "Werte vor dem Schreiben werden auf der Karte vermerkt.")
UI_TEXT(HP_ST_WRITE, 116,
    "Writing %u of %u. Do not disconnect.",
    "Schreiben: %u von %u. Trenne die Verbindung nicht.")
UI_TEXT(HP_ST_SAVE, 116,
    "Saving in the servo. It restarts.",
    "Werte werden im Servo gespeichert. Es startet neu.")
UI_TEXT(HP_ST_CHECK, 116,
    "Checking the values: reading %u of %u.",
    "Werte werden geprüft: Auslesen %u von %u.")
UI_TEXT(HP_ST_REREAD, 116,
    "Second read before the write: %u of %u.",
    "Zweites Auslesen vor dem Schreiben: %u von %u.")
UI_TEXT(HP_READS_DIFFER, 116,
    "Two reads differ at 0x%02X: read again with READ ALL.",
    "Zwei Auslesevorgänge weichen bei 0x%02X ab. Lies mit ALLES AUSLESEN erneut aus.")
UI_TEXT(HP_REPAIRED, 116,
    "Checksum written. Stored values 0x00-0x1C sum to 0.",
    "Prüfsumme geschrieben. Die Summe der Werte 0x00-0x1C ist 0.")
UI_TEXT(HP_RESTORED, 116,
    "Values before the interrupted write restored and verified.",
    "Werte vor dem unterbrochenen Schreibvorgang zurückgespielt und geprüft.")
UI_TEXT(HP_WRITE_OFF, 116,
    "Writing is off. Switch ENABLE WRITE TO SERVO on first.",
    "Schreiben ist gesperrt. Aktiviere zuerst SCHREIBEN INS SERVO FREIGEBEN.")
UI_TEXT(HP_M_NOT_READ, 116,
    "No servo read. Tap READ ALL.",
    "Kein Servo ausgelesen. Tippe auf ALLES AUSLESEN.")
UI_TEXT(HP_MUST_READ, 116,
    "A write was not verified. Tap READ ALL before writing again.",
    "Ein Schreibvorgang ist ungeprüft. Tippe vor dem nächsten Schreiben auf ALLES AUSLESEN.")
UI_TEXT(HP_NO_CHANGES, 116,
    "No values differ from the servo settings.",
    "Keine Werte weichen von den Servowerten ab.")
UI_TEXT(HP_EDITS_PENDING, 116,
    "Edited values are not written. Write them, or discard them under MORE, first.",
    "Geänderte Werte sind noch nicht geschrieben. Schreibe sie zuerst oder verwirf sie unter WEITERES.")
UI_TEXT(HP_E_RANGE, 116,
    "This value is not allowed for this setting.",
    "Dieser Wert ist für diese Einstellung nicht zulässig.")
UI_TEXT(HP_E_RO, 116,
    "This value is read only.",
    "Nur Anzeige. Dieser Wert lässt sich nicht ändern.")
UI_TEXT(HP_E_RAW, 116,
    "A value needed for this edit cannot be encoded. Nothing changed.",
    "Ein für diese Änderung benötigter Wert lässt sich nicht kodieren. Nichts geändert.")
UI_TEXT(HP_E_UNKNOWN, 116,
    "A value this edit needs was not read. Tap READ ALL.",
    "Ein benötigter Wert wurde nicht ausgelesen. Tippe auf ALLES AUSLESEN.")
UI_TEXT(HP_E_MIRROR, 116,
    "DIRECTION mirrors the positions. One would fall outside 1 to 16383.",
    "DREHRICHTUNG spiegelt die Positionen. Eine läge außerhalb von 1 bis 16383.")
UI_TEXT(HP_E_ORDER, 116,
    "LEFT END, NEUTRAL and RIGHT END must be in ascending order.",
    "ENDE LINKS, NEUTRAL und ENDE RECHTS müssen in aufsteigender Reihenfolge liegen.")
UI_TEXT(HP_CUT_REG, 116,
    "Writing was interrupted at register 0x%02X. Tap READ ALL.",
    "Schreiben bei Register 0x%02X unterbrochen. Tippe auf ALLES AUSLESEN.")
UI_TEXT(HP_CUT_SAVE, 116,
    "Writing was interrupted before the servo saved. Tap READ ALL.",
    "Schreiben vor dem Speichern im Servo unterbrochen. Tippe auf ALLES AUSLESEN.")
UI_TEXT(HP_CUT_REBOOT, 116,
    "Writing was interrupted after the save, before the restart. Tap READ ALL.",
    "Schreiben nach dem Speichern, vor dem Neustart unterbrochen. Tippe auf ALLES AUSLESEN.")
UI_TEXT(HP_CUT_CHECK, 116,
    "All values were sent, but verification was interrupted. Tap READ ALL.",
    "Alle Werte gesendet. Ihre Prüfung wurde unterbrochen. Tippe auf ALLES AUSLESEN.")
UI_TEXT(HP_CUT_CELL, 116,
    "Writing was interrupted at stored value 0x%02X. Tap READ ALL.",
    "Schreiben bei gespeichertem Wert 0x%02X unterbrochen. Tippe auf ALLES AUSLESEN.")
UI_TEXT(HP_CUT_SUM, 116,
    "Stored value 0x%02X is written, its checksum in 0x1C is not. Tap READ ALL.",
    "Gespeicherter Wert 0x%02X ist geschrieben, seine Prüfsumme in 0x1C nicht. Tippe auf ALLES AUSLESEN.")
UI_TEXT(HP_CUT_SUM_2, 116,
    "The checksum may be wrong: the servo may ignore PWM and draw current up to the supply limit.",
    "Prüfsumme möglicherweise falsch. Das Servo kann PWM ignorieren und Strom bis zur Strombegrenzung ziehen.")
UI_TEXT(HP_VERIFY_FAIL, 116,
    "Servo settings do not match after the write. Tap READ ALL.",
    "Servowerte stimmen nach dem Schreiben nicht überein. Tippe auf ALLES AUSLESEN.")
UI_TEXT(HP_REC_MIX_2, 116,
    "Do not use this servo. RESTORE recovers the values from before the write.",
    "Benutze dieses Servo nicht. ZURÜCKSPIELEN stellt die Werte vor dem Schreibvorgang wieder her.")
UI_TEXT(HP_RECORD_HELD, 116,
    "Writing and REPAIR CHECKSUM are blocked. Under RESTORE, restore the saved values or discard the record.",
    "Schreiben und PRÜFSUMME REPARIEREN gesperrt. Spiele unter ZURÜCKSPIELEN Werte zurück oder verwirf den Vermerk.")
UI_TEXT(HP_RECORD_BAD, 116,
    "Cannot read HITEC.TXT on the card. The file will not be used.",
    "HITEC.TXT auf der Karte ist nicht lesbar. Die Datei wird nicht verwendet.")
UI_TEXT(HP_SUM_OK, 116,
    "Stored values 0x00-0x1C sum to 0: nothing to repair.",
    "Die Summe der gespeicherten Werte 0x00-0x1C ist 0. Nichts zu reparieren.")
UI_TEXT(HP_ENABLE_D, 116,
    "The encodings come from 1 D series servo, a D485HW.",
    "Die Codierungen stammen von 1 Servo der D-Serie, einem D485HW.")
UI_TEXT(HP_ENABLE_C, 116,
    "The encodings come from 2 classic servos, an HS-5645MG and an HS-7955TG.",
    "Die Codierungen stammen von 2 klassischen Servos, einem HS-5645MG und einem HS-7955TG.")
UI_TEXT(HP_ENABLE_2, 116,
    "Wrong end points can drive the servo into its stops.",
    "Falsche Endpunkte können das Servo gegen seine Anschläge fahren.")
UI_TEXT(HP_ENABLE_3C, 116,
    "An interrupted write leaves a wrong checksum: the servo may ignore PWM and draw current up to the supply limit.",
    "Unterbrochenes Schreiben: Prüfsumme falsch. Servo kann PWM ignorieren und Strom bis zur Strombegrenzung ziehen.")
UI_TEXT(HP_WRITE_D, 116,
    "The servo saves and restarts. It ignores signals for 1s.",
    "Das Servo speichert und startet neu. Es ignoriert Signale 1s lang.")
UI_TEXT(HP_WRITE_C, 116,
    "Each stored value is followed by a write of the checksum in 0x1C.",
    "Nach jedem gespeicherten Wert wird die Prüfsumme in 0x1C geschrieben.")
UI_TEXT(HP_WRITE_RECORD, 116,
    "The values before the write are recorded on the card in HITEC.TXT.",
    "Die Werte vor dem Schreiben werden auf der Karte in HITEC.TXT vermerkt.")
UI_TEXT(HP_REPAIR_1, 116,
    "Writes stored value 0x1C: 0x%02X -> 0x%02X. Stored values 0x00-0x1C then sum to 0.",
    "Schreibt Wert 0x1C: 0x%02X -> 0x%02X. Die Summe der Werte 0x00-0x1C ist danach 0.")
UI_TEXT(HP_SOFT_OVERLOAD, 116,
    "Without overload protection a stalled servo heats up.",
    "Ohne Überlastschutz erhitzt sich ein blockiertes Servo.")
UI_TEXT(HP_ST_BACKUP, 116,
    "Saving the backup file on the card.",
    "Backup-Datei wird auf der Karte gespeichert.")
UI_TEXT(HP_FILE_DENIED, 116,
    "Cannot save: card write-protected, or BENCH/HITEC/CONF is not a folder.",
    "Speichern nicht möglich: Karte schreibgeschützt oder BENCH/HITEC/CONF kein Ordner.")
UI_TEXT(HP_LOAD_END, 116,
    "File damaged: it ends before its check line. Not loaded.",
    "Datei beschädigt: Sie endet vor ihrer Prüfzeile. Nicht geladen.")
UI_TEXT(HP_LOAD_HAND, 116,
