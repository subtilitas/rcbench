UI_TEXT(HG_FS_PANE, 0,
    "A second folder, USER/LOGS at the start. COPY and MOVE take the active pane's entry to the other.",
    "Ein zweiter Ordner, anfangs USER/LOGS. KOPIEREN und VERSCHIEBEN bringen den Eintrag in die andere Spalte.")
UI_TEXT(HG_FS_RESCAN, 0,
    "Checks the card slot and reads each pane's page again.",
    "Prüft den Kartenslot und liest die Seite jeder Spalte neu.")
UI_TEXT(HG_FS_COPY, 0,
    "Copies the selected file into the other pane's folder. A name there is never overwritten.",
    "Kopiert die gewählte Datei in den Ordner der anderen Spalte. Ein Name dort wird nie überschrieben.")
UI_TEXT(HG_FS_MOVE, 0,
    "Moves the selected file or folder into the other pane's folder. A FIXED folder stays.",
    "Verschiebt die gewählte Datei oder den Ordner in die andere Spalte. Ein FEST-Ordner bleibt.")
UI_TEXT(HG_FS_RENAME, 0,
    "Opens the keyboard with the selected entry's name.",
    "Öffnet die Tastatur mit dem Namen des gewählten Eintrags.")
UI_TEXT(HG_FS_DELETE, 0,
    "Asks first. A folder must be empty; a run's CSV takes its report along.",
    "Fragt zuerst. Ein Ordner muss leer sein; die CSV eines Laufs nimmt ihren Bericht mit.")
UI_TEXT(HG_FS_NEW, 0,
    "Makes a folder or an empty text file in the active pane, named on the keyboard.",
    "Legt in der aktiven Spalte einen Ordner oder eine leere Textdatei an, benannt über die Tastatur.")
UI_TEXT(HG_FS_INFO, 0,
    "Shows the selected entry's folder, kind, size, time and the rule that applies to it.",
    "Zeigt Ordner, Art, Größe, Zeit und die geltende Regel des gewählten Eintrags.")
UI_TEXT(HG_FS_OPEN, 0,
    "Enters a folder, opens a log CSV in LOGS and another file up to 1MiB in the text viewer.",
    "Öffnet einen Ordner, eine Log-CSV in LOGS und andere Dateien bis 1MiB im Textbetrachter.")
