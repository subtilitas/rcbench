UI_TEXT(SP_WARN_TITLE, 0,
    "PROPELLER REMOVED? MOTOR SECURED?",
    "PROPELLER AB? MOTOR GESICHERT?")
UI_TEXT(SP_WARN_1, 0,
    "This run powers the ESC from the supply and moves the throttle to MAX",
    "Dieser Lauf versorgt den ESC aus dem Netzteil und setzt das Gassignal auf MAX")
UI_TEXT(SP_WARN_2, 0,
    "and back to step through its programming menu. In rare cases, the motor",
    "und zurück, um das Programmiermenü zu bedienen. In seltenen Fällen kann")
UI_TEXT(SP_WARN_3, 0,
    "may start running. Secure any connected motor firmly",
    "der Motor anlaufen. Befestige einen angeschlossenen Motor sicher")
UI_TEXT(SP_WARN_4, 0,
    "and remove the propeller. A resistor load can replace the motor.",
    "und entferne den Propeller. Ein Lastwiderstand kann den Motor ersetzen.")
UI_TEXT(SP_WARN_5, 0,
    "Beeps are detected and counted from the current.",
    "Die Pieptöne werden anhand des Stroms erkannt und gezählt.")
UI_TEXT(SP_WARN_SUPPLY, 96,
