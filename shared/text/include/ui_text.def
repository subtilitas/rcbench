UI_TEXT(KP_R_PLAN_PAIRING, 116,
    "The pairing value differs. Use RELEASE PAIRING.",
    "Der Pairing-Wert weicht ab. Nutze PAIRING LÖSEN.")
UI_TEXT(KP_R_PLAN_NO_PATH, 116,
