    "Schreiben fehlgeschlagen. Kein Wert wurde unvollständig geschrieben.")
UI_TEXT(KP_S_ROLLED_BACK, 116,
    "Write failed. The previous value was restored.",
    "Schreiben fehlgeschlagen. Der vorherige Wert wurde zurückgespielt.")
UI_TEXT(KP_S_WRITE_PART, 116,
    "Write failed. Earlier writes remain. Tap READ ALL.",
    "Schreiben fehlgeschlagen. Zuvor geschriebene Werte bleiben. Tippe auf ALLES AUSLESEN.")
UI_TEXT(KP_S_TORN, 116,
    "Write failed and could not be undone.",
    "Schreiben fehlgeschlagen. Der Vorgang ließ sich nicht rückgängig machen.")
UI_TEXT(KP_S_UNINTENDED, 116,
    "A register changed without being written.",
    "Ein Register hat sich ohne Schreibzugriff geändert.")
UI_TEXT(KP_S_VERIFY, 116,
    "Servo settings do not match the expected values.",
    "Das Servo enthält nicht die erwarteten Werte.")
UI_TEXT(KP_S_DRIVER, 116,
    "Port driver failed. Tap READ ALL.",
    "Porttreiber ausgefallen. Tippe auf ALLES AUSLESEN.")
UI_TEXT(KP_S_ABORTED, 116,
    "Operation aborted. Tap READ ALL.",
    "Vorgang abgebrochen. Tippe auf ALLES AUSLESEN.")
UI_TEXT(KP_S_SUPPLY, 116,
    "The supply did not switch within %ums. Check the supply.",
    "Die Versorgung hat nicht innerhalb von %ums geschaltet. Prüfe die Versorgung.")
UI_TEXT(KP_S_TOO_COMPLEX, 116,
    "Too many changes to plan at once. Nothing written.",
    "Zu viele Änderungen für einen gemeinsamen Plan. Nichts geschrieben.")
UI_TEXT(KP_S_TOO_COMPLEX_2, 116,
    "Split the changes. Write fewer values at a time.",
    "Teile die Änderungen auf. Schreibe weniger Werte auf einmal.")
UI_TEXT(KP_H_DUTY_HIGH, 116,
    "MAX. DUTY exceeds its upper limit.",
    "MAX. DUTY überschreitet die Obergrenze.")
UI_TEXT(KP_H_DUTY_LOW, 116,
    "MAX. DUTY is below its lower limit.",
    "MAX. DUTY liegt unter der Untergrenze.")
UI_TEXT(KP_H_DUTY_COPY, 116,
    "The two duty registers contain different values.",
    "Die beiden Duty-Register enthalten unterschiedliche Werte.")
UI_TEXT(KP_H_BOOST_HIGH, 116,
    "BOOST exceeds its upper limit.",
    "BOOST überschreitet die Obergrenze.")
UI_TEXT(KP_H_STRETCH_INDEX, 116,
    "This STRETCH value has not been confirmed.",
    "Dieser STRETCH-Wert ist nicht bestätigt.")
UI_TEXT(KP_H_SPD_HIGH, 116,
    "SPEED exceeds its upper limit.",
    "TEMPO überschreitet die Obergrenze.")
UI_TEXT(KP_H_SPD_SEL_LOW_SPD, 116,
    "SPEED LIMIT requires SPEED to be above the minimum.",
    "TEMPOGRENZE erfordert ein TEMPO über dem Mindestwert.")
UI_TEXT(KP_H_UNCONT_POS_LOW, 116,
    "Failsafe position is below its lower limit.",
    "Failsafe-Position liegt unter der Untergrenze.")
UI_TEXT(KP_H_UNCONT_POS_HIGH, 116,
    "Failsafe position exceeds its upper limit.",
    "Failsafe-Position überschreitet die Obergrenze.")
UI_TEXT(KP_H_UNCONT_POS_SPAN, 116,
    "Failsafe position must be between PULSE LOWER and PULSE UPPER.",
    "Failsafe-Position muss zwischen PULSE LOWER und PULSE UPPER liegen.")
UI_TEXT(KP_H_UNCONT_TIME_LOW, 116,
    "Failsafe delay is below its lower limit.",
    "Failsafe-Zeit liegt unter der Untergrenze.")
UI_TEXT(KP_H_UNCONT_TIME_HIGH, 116,
    "Failsafe delay exceeds its upper limit.",
    "Failsafe-Zeit überschreitet die Obergrenze.")
UI_TEXT(KP_H_LOWER_LOW, 116,
    "PULSE LOWER is below its lower limit.",
    "PULSE LOWER liegt unter der Untergrenze.")
UI_TEXT(KP_H_LOWER_MARGIN, 116,
    "PULSE LOWER is too close to NEUTRAL.",
    "PULSE LOWER liegt zu nah an NEUTRAL.")
UI_TEXT(KP_H_UPPER_HIGH, 116,
    "PULSE UPPER exceeds its upper limit.",
    "PULSE UPPER überschreitet die Obergrenze.")
UI_TEXT(KP_H_UPPER_MARGIN, 116,
    "PULSE UPPER is too close to NEUTRAL.",
    "PULSE UPPER liegt zu nah an NEUTRAL.")
UI_TEXT(KP_H_SPAN, 116,
    "PULSE LOWER and PULSE UPPER are too close together.",
    "PULSE LOWER und PULSE UPPER liegen zu nah beieinander.")
UI_TEXT(KP_H_NEUTRAL_LOW, 116,
    "NEUTRAL is below its lower limit.",
    "NEUTRAL liegt unter der Untergrenze.")
UI_TEXT(KP_H_NEUTRAL_HIGH, 116,
    "NEUTRAL exceeds its upper limit.",
    "NEUTRAL überschreitet die Obergrenze.")
UI_TEXT(KP_H_LEFT_ZERO, 116,
    "LEFT ANGLE must not be 0.",
    "LEFT ANGLE darf nicht 0 sein.")
UI_TEXT(KP_H_RIGHT_ZERO, 116,
    "RIGHT ANGLE must not be 0.",
    "RIGHT ANGLE darf nicht 0 sein.")
UI_TEXT(KP_H_GYRO_MODE, 116,
    "Gyro mode limits are unknown. Writing is blocked.",
    "Grenzen im Gyro-Modus unbekannt. Schreiben ist gesperrt.")
UI_TEXT(KP_H_LOCKED, 116,
    "A locked value differs. It will not be written.",
    "Ein gesperrter Wert weicht ab. Er wird nicht geschrieben.")
UI_TEXT(KP_H_NEVER, 116,
    "A value that is never written differs.",
    "Ein Wert, der nie geschrieben wird, weicht ab.")
UI_TEXT(KP_W_DUTY_RAISED, 116,
    "A higher MAX. DUTY increases stall current and heat.",
    "Ein höherer Wert für MAX. DUTY erhöht Blockierstrom und Erwärmung.")
UI_TEXT(KP_W_DUTY_BELOW_HALF, 116,
    "A low MAX. DUTY weakens the servo. It may not hold the control surface.",
    "Ein niedriger MAX. DUTY-Wert schwächt das Servo. Es hält das Ruder eventuell nicht.")
UI_TEXT(KP_W_BOOST_RAISED, 116,
    "A higher BOOST can cause buzzing and heat.",
    "Ein höherer BOOST-Wert kann Brummen und Erwärmung verursachen.")
UI_TEXT(KP_W_STRETCH_RAISED, 116,
    "A higher STRETCH can cause servo oscillation.",
    "Ein höherer STRETCH-Wert kann das Servo zum Schwingen bringen.")
UI_TEXT(KP_W_SOFT_START_OFF, 116,
    "Without SOFT START, the servo moves abruptly at power-on.",
    "Ohne SOFT START bewegt sich das Servo beim Einschalten ruckartig.")
UI_TEXT(KP_W_SPD_SEL_ON, 116,
    "Speed limit active. The servo moves at the set speed.",
    "Tempogrenze aktiv. Das Servo bewegt sich mit dem eingestellten Tempo.")
UI_TEXT(KP_W_SPD_SLOW, 116,
    "A slow servo can cause loss of control of the model.",
    "Ein zu langsames Servo kann zum Kontrollverlust über das Modell führen.")
UI_TEXT(KP_W_DEAD_BAND_NARROWED, 116,
    "A narrow DEAD BAND can cause back-and-forth movement and heat.",
    "Ein kleiner DEAD BAND-Wert kann Pendeln und Erwärmung verursachen.")
UI_TEXT(KP_W_DEAD_BAND_BELOW_1US, 116,
    "Very narrow DEAD BAND. Back-and-forth movement and heat are likely.",
    "Sehr kleiner DEAD BAND-Wert. Pendeln und Erwärmung sind wahrscheinlich.")
UI_TEXT(KP_W_ALLOW_UNCONT_ON, 116,
    "On signal loss the servo moves to the failsafe position.",
    "Ohne Signal fährt das Servo auf die Failsafe-Position.")
UI_TEXT(KP_W_UNCONT_POS_FAR, 116,
    "Failsafe position is far from the centre.",
    "Die Failsafe-Position liegt weit von der Mitte entfernt.")
UI_TEXT(KP_W_UNCONT_TIME_SHORT, 116,
    "Short dropouts will trigger the failsafe move.",
    "Kurze Aussetzer lösen die Failsafe-Bewegung aus.")
UI_TEXT(KP_W_END_NEAR, 116,
    "End point close to NEUTRAL. Little travel remains on this side.",
    "Endpunkt nah an NEUTRAL. Auf dieser Seite bleibt wenig Weg.")
UI_TEXT(KP_W_END_MOVED, 116,
    "End point changed. The servo travel per stick movement changes too.",
    "Endpunkt geändert. Dadurch ändert sich auch der Servoweg je Knüppelbewegung.")
UI_TEXT(KP_W_NEUTRAL_MOVED, 116,
    "The centre shifts. One side moves closer to the mechanical stop.",
    "Die Mitte verschiebt sich. Eine Seite kommt näher an den mechanischen Anschlag.")
UI_TEXT(KP_W_REVERSION_CHANGED, 116,
    "Direction reversed. Check all control surfaces before flight.",
    "Drehrichtung umgekehrt. Prüfe vor dem Flug alle Ruder.")
UI_TEXT(KP_W_ANGLE_RAISED, 116,
    "More travel can push the servo against its stop and burn it out.",
    "Mehr Weg kann das Servo gegen den Anschlag fahren und durchbrennen lassen.")
UI_TEXT(KP_W_ANGLE_SMALL, 116,
    "Small angle. Full stick movement gives little servo travel.",
    "Kleiner Winkel. Voller Knüppelweg ergibt nur wenig Servoweg.")
UI_TEXT(KP_W_GYRO_CHANGED, 116,
    "Pulse standard changed. The wrong standard drives the servo into its stop.",
    "Pulsstandard geändert. Ein falscher Standard fährt das Servo in den Anschlag.")
UI_TEXT(KP_W_NARROW_BAND_GAIN, 116,
    "A narrow DEAD BAND and higher gain can cause oscillation.",
    "Ein kleiner DEAD BAND-Wert und mehr Gain können Schwingungen verursachen.")
UI_TEXT(KP_W_HIGH_DUTY_TRAVEL, 116,
    "A high MAX. DUTY and more travel: a stall can destroy the servo.",
    "Hoher Wert für MAX. DUTY und mehr Weg: Blockieren kann das Servo zerstören.")
/* --------------------- end of the servo programmer */

