UI_TEXT(KP_M_JOURNAL_DONE, 116,
    "It has the new values. If this is the same servo, discard the record under RESTORE.",
    "Es enthält die neuen Werte. Ist es dasselbe Servo, verwirf den Vermerk unter ZURÜCKSPIELEN.")
UI_TEXT(KP_M_INCONSISTENT, 116,
    "The servo contains both old and new settings.",
    "Das Servo enthält alte und neue Werte gemischt.")
UI_TEXT(KP_M_DO_NOT_USE, 116,
    "Do not use this servo. Recover the backup with RESTORE.",
