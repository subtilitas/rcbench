/* The parameter tables of prog_models.c, which no list shows: no transport
 * on the IOmcu carries these protocols. */
UI_TEXT(PG_GROUP_MOTOR, 10,
    "MOTOR",
    "MOTOR")
UI_TEXT(PG_GROUP_STARTUP, 10,
    "STARTUP",
    "ANLAUF")
UI_TEXT(PG_GROUP_PROTECTION, 10,
    "PROTECTION",
    "SCHUTZ")
UI_TEXT(PG_GROUP_SOUND, 10,
    "SOUND",
    "TON")
UI_TEXT(PG_GROUP_REPORTING, 10,
    "REPORTING",
