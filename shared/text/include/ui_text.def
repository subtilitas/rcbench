/* --------------------------------------------- the band's help bubbles
 * A tap on a chip of the band opens one.  Each is wrapped to the bubble's
 * width, so a view draws it and --fit measures it there; test_nav_bubble holds
 * the bubble above the alert strip in its tallest state. */
UI_TEXT(BH_LINK_UP, 0,
    "The IOmcu is responding on the CAN bus. The screens control its outputs and show its readings. The panel requests data every 50ms. If the IOmcu stops responding while ARMED, the bench switches to SAFE.",
    "Der IOmcu antwortet am CAN-Bus. Die Seiten steuern seine Ausgänge und zeigen seine Messwerte. Das Panel fragt alle 50ms Daten ab. Antwortet der IOmcu bei ARMED nicht mehr, schaltet der Prüfstand auf SAFE.")
UI_TEXT(BH_NO_LINK, 0,
    "No IOmcu is responding. The panel tries once a second. The screens show simulated data, and the IOmcu outputs stay off. Check the IOmcu's power supply and CAN cable. A different major protocol version also causes NO LINK. Install firmware from the same release on both boards.",
    "Kein IOmcu antwortet. Das Panel versucht es einmal pro Sekunde. Die Seiten zeigen simulierte Daten. Die Ausgänge des IOmcu bleiben aus. Prüfe seine Versorgung und das CAN-Kabel. Eine andere Hauptversion des Protokolls führt ebenfalls zu KEINE VERBINDUNG. Installiere auf beiden Platinen Firmware aus demselben Release.")
UI_TEXT(BH_MODE_BENCH, 0,
    "The IOmcu is responding. The screens control its outputs and show its data. If it stops responding, the mode changes to SIM.",
    "Der IOmcu antwortet. Die Seiten steuern seine Ausgänge und zeigen seine Daten. Antwortet er nicht mehr, wechselt der Modus zu SIM.")
UI_TEXT(BH_MODE_SIM, 0,
    "No IOmcu is responding. The panel simulates the values; they are not measurements. ARM does not activate any output. When an IOmcu responds, the mode changes to BENCH and any simulated ARMED state resets to SAFE.",
    "Kein IOmcu antwortet. Das Panel simuliert die Werte. Es sind keine Messwerte. ARM aktiviert keinen Ausgang. Sobald ein IOmcu antwortet, wechselt der Modus zu BENCH. Ein in der Simulation gesetztes ARMED wird auf SAFE zurückgesetzt.")
/* INJECT's two paragraphs: in a build with RCBENCH_TOUCH_INJECTOR (the
 * default; OFF drops them).  The host suite and render_ui.py build with it.
 * The define rides with this header's include path (shared/text's
 * CMakeLists.txt), so every file that reads the table sees the same set.
 * Only UI_TEXT entries stand under it: test_merge_texts fails on any other. */
#ifdef RCBENCH_TOUCH_INJECTOR
UI_TEXT(BH_MODE_INJECT, 0,
    "Touch input also comes from the injector at I2C address 0x14. It is combined with input from the panel touchscreen, which still works. LINK shows whether an IOmcu responds. The older of the two sources determines the touch age. A contact on the touchscreen counts as detected touch. Without a controller at 0x5D, the status always shows INJECT. If the injector was absent at startup, a restart is needed.",
    "Touch-Eingaben kommen auch vom Injector an der I2C-Adresse 0x14. Sie werden mit den Eingaben des weiterhin nutzbaren Touchscreens zusammengeführt. LINK zeigt, ob ein IOmcu antwortet. Für das Touch-Alter zählt die ältere der beiden Quellen. Eine Berührung am Touchscreen zählt als erkannter Touch. Ohne Controller an 0x5D steht die Anzeige immer auf INJECT. Fehlte der Injector beim Start, ist ein Neustart nötig.")
UI_TEXT(BH_MODE_INJECT_LOST, 0,
    "With a controller at 0x5D, injector contacts are released after 3 failed reads in a row. If the touchscreen has no contact, touch is marked silent 200ms after the injector's last reply. After another 500ms, the bench switches to SAFE and blocks ARM. After 1000ms of silence, the injector is detached. The touchscreen alone then sets the touch age, ARM is available again, and the status shows BENCH or SIM. The injector is checked every 1000ms and reconnected when it replies.",
    "Mit einem Controller an 0x5D werden Injector-Kontakte nach 3 fehlgeschlagenen Abfragen in Folge aufgehoben. Ohne Berührung am Touchscreen gilt Touch 200ms nach der letzten Injector-Antwort als stumm. Weitere 500ms später schaltet der Prüfstand auf SAFE und sperrt ARM. Nach 1000ms Stille wird der Injector getrennt. Dann bestimmt allein der Touchscreen das Touch-Alter. ARM ist wieder möglich, und die Anzeige zeigt BENCH oder SIM. Der Injector wird alle 1000ms abgefragt und bei einer Antwort wieder verbunden.")
#endif
UI_TEXT(BH_SAFE, 0,
    "Motor and servo outputs send no pulses. To activate them, hold ARM for 2s on MOTOR & ESC or SERVO. The PD mini output on SUPPLY is switched separately. STOP turns it off too.",
    "Motor- und Servoausgänge geben keine Pulse aus. Halte ARM auf MOTOR & ESC oder SERVO für 2s, um sie zu aktivieren. Der PD-mini-Ausgang auf SUPPLY wird getrennt davon geschaltet. STOP schaltet auch ihn aus.")
UI_TEXT(BH_ARMED_MOTOR, 0,
    "Motor outputs send pulses. Servo outputs do not.",
    "Motorausgänge geben Pulse aus. Servoausgänge nicht.")
UI_TEXT(BH_ARMED_SERVO, 0,
    "Servo outputs send pulses. Motor outputs do not.",
    "Servoausgänge geben Pulse aus. Motorausgänge nicht.")
UI_TEXT(BH_ARMED_ALL, 0,
    "All assigned motor and servo outputs send pulses.",
    "Alle zugeordneten Motor- und Servoausgänge geben Pulse aus.")
UI_TEXT(BH_ARMED_REST, 0,
    "A channel with no command for 500ms returns to rest: throttle at 0, servo at the centre of its travel. STOP, DISARM or leaving the screen switches the bench to SAFE.",
    "Erhält ein Kanal 500ms keinen Befehl, geht er in Ruhestellung: Gas auf 0, Servo in die Mitte seines Wegs. STOP, DISARM oder das Verlassen der Seite schaltet den Prüfstand auf SAFE.")
UI_TEXT(BH_ARMED_SIM, 0,
    "No IOmcu is responding. ARM runs the panel's simulation, not real outputs.",
    "Kein IOmcu antwortet. ARM startet nur die Simulation des Panels. Keine echten Ausgänge werden angesteuert.")
UI_TEXT(BH_CLOCK, 0,
    "Shows the run time since switching to ARMED. At SAFE, the clock stops and keeps the last run time until the next ARM. It shows minutes and seconds, adding hours from 60min.",
    "Zeigt die Laufzeit seit dem Wechsel zu ARMED. Bei SAFE stoppt die Uhr und zeigt die letzte Laufzeit bis zum nächsten ARM. Anzeige in Minuten und Sekunden, ab 60min auch in Stunden.")
UI_TEXT(BH_F_LINK_SILENT, 0,
    "The IOmcu received no data for 200ms and switched itself to SAFE. The PD mini output is off. A panel restart or loose CAN cable can cause this. The fault bit stays set until the next ARM. If it returns, check the CAN cable.",
    "Der IOmcu hat 200ms keine Daten empfangen und selbst auf SAFE geschaltet. Der PD-mini-Ausgang ist aus. Ursache kann ein Panel-Neustart oder ein lockeres CAN-Kabel sein. Das Fehlerbit bleibt bis zum nächsten ARM gesetzt. Tritt es erneut auf, prüfe das CAN-Kabel.")
UI_TEXT(BH_F_OVERCURRENT, 0,
    "Stopped due to overcurrent.",
    "Wegen Überstrom gestoppt.")
UI_TEXT(BH_F_OVERTEMP, 0,
    "Stopped due to overheating.",
    "Wegen Übertemperatur gestoppt.")
UI_TEXT(BH_F_STALL, 0,
    "Stopped because the motor stalled.",
    "Wegen blockiertem Motor gestoppt.")
UI_TEXT(BH_F_HEARTBEAT, 0,
    "The safety signal from the panel to the IOmcu has stopped. After any stop, the panel keeps it stopped until the next ARM. Otherwise, the emergency stop is pressed or the heartbeat wire is open. The IOmcu is SAFE and blocks ARMED. The PD mini output is off. Release the emergency stop or check the wire, then hold ARM.",
    "Das Sicherheitssignal vom Panel zum IOmcu ist ausgefallen. Nach jedem Stopp hält das Panel es bis zum nächsten ARM an. Andernfalls ist der Not-Aus gedrückt oder die Heartbeat-Leitung unterbrochen. Der IOmcu ist SAFE und sperrt ARMED. Der PD-mini-Ausgang ist aus. Löse den Not-Aus oder prüfe die Leitung und halte danach ARM.")
UI_TEXT(BH_F_VERSION, 0,
    "The versions on the two devices do not match.",
    "Die Versionen der beiden Geräte passen nicht zusammen.")
UI_TEXT(BH_F_STORE_OFF, 0,
    "The IOmcu cannot write flash during this boot. Sent settings work from RAM but are lost at restart. Restart it to try again. Whether that clears the fault bit has not been tested.",
    "Der IOmcu kann seit diesem Start nicht in den Flash schreiben. Übertragene Einstellungen wirken nur aus dem RAM und gehen beim Neustart verloren. Starte ihn neu und versuche es erneut. Ob das Fehlerbit dadurch verschwindet, wurde nicht geprüft.")
UI_TEXT(BH_F_NEVER, 0,
    "This release never sets this bit.",
    "Dieses Release setzt dieses Bit nie.")
UI_TEXT(BH_F_OTHER, 0,
    "Other bits (%04X) are unknown to this panel.",
    "Weitere Bits (%04X) sind diesem Panel unbekannt.")
UI_TEXT(BH_F_FLASH, 0,
    "If a bit appears that this release never sets, install firmware from the same release on both boards.",
    "Erscheint ein Bit, das dieses Release nie setzt, installiere auf beiden Platinen Firmware aus demselben Release.")

/* ------------------------------------------------------- keypads */
UI_TEXT(KEYPAD_RANGE, 0,
    "%.*f to %.*f%s%s",
    "%.*f bis %.*f%s%s")
/* The range of a pin setting: the pin word first, as in "GPIO 0 to 54"
 * (ui_unit_is_prefix()). */
UI_TEXT(KEYPAD_RANGE_PRE, 0,
    "%s %.*f to %.*f",
    "%s %.*f bis %.*f")
/* Why a setting's keypad refused a value inside its range, in place of the
 * range (ui_setting_keypad.c): a value between 0 and the row's off_below
 * (the row's off_below, maximum and unit, with its step's decimals: a
 * SENSORS shunt's "0 or 5.0 to 1000.0mΩ", a SENSORS limit's "0 or 10
 * to 32767mA"), a Sensor SDA pin the bus cannot have (the pins
 * settings_sense_sda_valid() takes, listed where it is drawn), the other
 * PD mini pin's GPIO. */
UI_TEXT(KEYPAD_WHY_OFF, 0,
    "0 or %.*f to %.*f%s%s",
    "0 oder %.*f bis %.*f%s%s")
UI_TEXT(KEYPAD_WHY_SDA, 0,
    "Pins the bus takes: %s",
    "Pins, die der Bus nimmt: %s")
/* The first number is the largest Idle pulse (the smallest Full pulse) the
 * pair takes, the second the gap, LINK_CC_THROTTLE_GAP_US. */
