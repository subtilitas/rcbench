/* ------------------------------------------------------ the options
 * Each list is bound to its settings by the schema (ENUM_OPTS in
 * settings.c, the rows of settings_sensors.c).  A list whose words are
 * the same in every language -- the language names, addresses, channels,
 * baud rates -- has NULL German. */
UI_OPTIONS(theme)
UI_OPTION("DARK", "DUNKEL")
UI_OPTION("LIGHT", "HELL")
UI_OPTIONS_END(theme)

UI_OPTIONS(screen_rot)
UI_OPTION("NORMAL", NULL)
UI_OPTION("180°", NULL)
UI_OPTIONS_END(screen_rot)

/* The text editor's keyboard: the percent of the text behind that shows
 * through (ui_textkey_see_pct()). */
UI_OPTIONS(kb_see)
UI_OPTION("OFF", "AUS")
UI_OPTION("25%", NULL)
UI_OPTION("50%", NULL)
UI_OPTIONS_END(kb_see)

UI_OPTIONS(language)
UI_OPTION("ENGLISH", NULL)
UI_OPTION("DEUTSCH", NULL)
UI_OPTIONS_END(language)

UI_OPTIONS(units)
UI_OPTION("METRIC", "METRISCH")
UI_OPTION("IMPERIAL", "IMPERIAL")
UI_OPTIONS_END(units)

/* The time zones, in wall_clock.c's order of POSIX TZ strings
 * (wall_zone_posix()); Berlin is the default. */
UI_OPTIONS(time_zone)
UI_OPTION("UTC", NULL)
UI_OPTION("LONDON", NULL)
UI_OPTION("BERLIN", NULL)
UI_OPTION("HELSINKI", NULL)
UI_OPTION("NEW YORK", NULL)
UI_OPTION("CHICAGO", NULL)
UI_OPTION("DENVER", NULL)
UI_OPTION("LOS ANGELES", NULL)
UI_OPTION("TOKYO", NULL)
UI_OPTION("SYDNEY", NULL)
UI_OPTIONS_END(time_zone)

/* The INA228's address, 0x40 + the option: A0 and A1 each to GND, VS, SDA
 * or SCL give sixteen. */
UI_OPTIONS(ina228_addr)
UI_OPTION("0x40", NULL)
UI_OPTION("0x41", NULL)
UI_OPTION("0x42", NULL)
UI_OPTION("0x43", NULL)
UI_OPTION("0x44", NULL)
UI_OPTION("0x45", NULL)
UI_OPTION("0x46", NULL)
UI_OPTION("0x47", NULL)
UI_OPTION("0x48", NULL)
UI_OPTION("0x49", NULL)
UI_OPTION("0x4A", NULL)
UI_OPTION("0x4B", NULL)
UI_OPTION("0x4C", NULL)
UI_OPTION("0x4D", NULL)
UI_OPTION("0x4E", NULL)
UI_OPTION("0x4F", NULL)
UI_OPTIONS_END(ina228_addr)

UI_OPTIONS(servo_curve)
UI_OPTION("SQUARE", "RECHTECK")
UI_OPTION("SINE", "SINUS")
UI_OPTION("TRIANGLE", "DREIECK")
UI_OPTIONS_END(servo_curve)

UI_OPTIONS(servo_len_by)
UI_OPTION("TIME", "ZEIT")
UI_OPTION("MOVES", "BEWEGUNGEN")
UI_OPTIONS_END(servo_len_by)

/* What the SERVO tester drives: the standard servo outputs, or
 * programming port n as PORT n.  A value stored as PROG PORT (1) before
 * there were four reads as PORT 1. */
UI_OPTIONS(servo_target)
UI_OPTION("OUTPUTS", "OUTPUTS")
UI_OPTION("PORT 1", "PORT 1")
UI_OPTION("PORT 2", "PORT 2")
UI_OPTION("PORT 3", "PORT 3")
UI_OPTION("PORT 4", "PORT 4")
UI_OPTIONS_END(servo_target)

/* The series of the programmer for servos by Hitec, in hitec_family_t's
 * order. */
UI_OPTIONS(hitec_series)
UI_OPTION("CLASSIC", "KLASSISCH")
UI_OPTION("D SERIES", "D-SERIE")
UI_OPTIONS_END(hitec_series)

UI_OPTIONS(upd_channel)
UI_OPTION("STABLE", NULL)
UI_OPTION("TESTING", NULL)
UI_OPTIONS_END(upd_channel)

/* What a browser write to the card needs (wa_writes_t's order): nothing
 * beyond the page, the access code, a hold on WI-FI, or no write. */
UI_OPTIONS(web_writes)
UI_OPTION("OPEN", "OFFEN")
UI_OPTION("ACCESS CODE", "ZUGANGSCODE")
UI_OPTION("HOLD", "HALTEN")
UI_OPTION("OFF", "AUS")
UI_OPTIONS_END(web_writes)

/* How a Hitec D series line on the programming port receives, in
 * link_hitec_rx_t's order. */
UI_OPTIONS(hitec_rx)
UI_OPTION("PULL-UP", NULL)
UI_OPTION("PRECHARGE", NULL)
UI_OPTIONS_END(hitec_rx)

/* The PD mini's own UART Baudrate setting, 0 to 6, in its order. */
UI_OPTIONS(pdmini_baud)
UI_OPTION("9600", NULL)
UI_OPTION("19200", NULL)
UI_OPTION("38400", NULL)
UI_OPTION("57600", NULL)
UI_OPTION("115200", NULL)
UI_OPTION("230400", NULL)
UI_OPTION("460800", NULL)
UI_OPTION("AUTO", NULL)
UI_OPTIONS_END(pdmini_baud)

/* What a channel watches: the output channels, the programming ports,
 * the supply rail, and a board's own rails (the rbmod carrier's INA3221,
 * shown only where the board holds the row), in SENS_W_* order. */
UI_OPTIONS(watch)
UI_OPTION("NONE", "KEINE")
