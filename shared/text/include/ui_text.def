UI_TEXT(KP_BENCH_FIRST, 116,
    "Test the servo on the bench before fitting it to a model.",
    "Teste das Servo am Prüfstand, bevor du es ins Modell einbaust.")
UI_TEXT(KP_ENABLE_1, 116,
    "These limits are based on 1 servo of an unknown model.",
    "Diese Grenzen beruhen auf 1 Servo unbekannten Typs.")
UI_TEXT(KP_ENABLE_2, 116,
    "Wrong settings can overheat or stall the servo.",
    "Falsche Werte können das Servo überhitzen oder blockieren.")
UI_TEXT(KP_ENABLE_3, 116,
    "An interrupted write can make the servo unusable.",
    "Ein unterbrochener Schreibvorgang kann das Servo unbrauchbar machen.")
UI_TEXT(KP_ENABLE_4, 116,
    "The first write backs up the servo's settings to the card.",
    "Beim ersten Schreiben werden die Servowerte auf der Karte gesichert.")
UI_TEXT(KP_ENABLE_5, 116,
    "Writing is disabled for each new servo and whenever this screen opens.",
    "Schreiben wird bei jedem neuen Servo und jedem Aufruf dieser Seite gesperrt.")
UI_TEXT(KP_WRITE_1, 116,
    "Only changed values are written. Each value is checked afterwards.",
    "Nur geänderte Werte werden geschrieben und danach einzeln geprüft.")
UI_TEXT(KP_WRITE_2, 116,
