UI_TEXT(BF_STOPPED_3, 0,
    "Take a photo of this screen and report the fault.",
    "Fotografiere diese Seite und melde den Fehler.")
UI_TEXT(BF_SILENT_MEANS, 0,
    "No response on the bus. The two boards cannot communicate.",
    "Keine Antwort am Bus. Die beiden Platinen können keine Daten austauschen.")
UI_TEXT(BF_CORRUPT_MEANS, 0,
    "Frames arrive with changed data. Check the wiring and bit timing.",
    "Frames kommen mit veränderten Daten an. Verkabelung und Bit-Timing prüfen.")
UI_TEXT(BF_LOSSY_MEANS, 0,
    "Some frames are lost, and the bus reports errors.",
    "Einige Frames gehen verloren. Der Bus meldet Fehler.")
UI_TEXT(BF_DROPPED_MEANS, 0,
    "Frames arrived intact, then were discarded unread. Not a wiring fault.",
    "Frames kamen korrekt an, wurden aber ungelesen verworfen. Kein Verkabelungsfehler.")
UI_TEXT(BF_SILENT_1, 0,
    "Check the IOmcu's power LED, not the panel's.",
    "Prüfe die Versorgungs-LED am IOmcu, nicht die am Panel.")
UI_TEXT(BF_SILENT_2, 0,
    "Connect CANH to CANH and CANL to CANL. Do not cross them.",
    "CANH mit CANH und CANL mit CANL verbinden. Nicht vertauschen.")
UI_TEXT(BF_SILENT_3, 0,
    "Both boards must use firmware from the same release.",
    "Beide Platinen müssen Firmware aus demselben Release nutzen.")
UI_TEXT(BF_SILENT_4, 0,
    "With the bench off, measure about 60Ω",
    "Bei ausgeschaltetem Prüfstand etwa 60Ω")
UI_TEXT(BF_SILENT_5, 0,
    "  between CANH and CANL for correct termination.",
    "  zwischen CANH und CANL messen: Busabschluss prüfen.")
UI_TEXT(BF_CORRUPT_1, 0,
    "With the bench off, expect about 60Ω between CANH and CANL.",
    "Prüfstand ausschalten. Zwischen CANH und CANL sollten etwa 60Ω liegen.")
UI_TEXT(BF_CORRUPT_2, 0,
    "  A reading of 120Ω means one terminator is missing.",
    "  Bei 120Ω fehlt einer der beiden Abschlusswiderstände.")
UI_TEXT(BF_CORRUPT_3, 0,
    "Keep the branch to each board under 30cm.",
    "Stichleitung zu jeder Platine unter 30cm halten.")
UI_TEXT(BF_TWISTED, 0,
    "Twist CANH and CANL together. Keep them away from motor wires.",
    "CANH und CANL verdrillen. Abstand zu Motorleitungen halten.")
UI_TEXT(BF_LOSSY_1, 0,
    "With the bench off, check for about 60Ω between CANH and CANL.",
    "Prüfstand ausschalten. Zwischen CANH und CANL sollten etwa 60Ω liegen.")
UI_TEXT(BF_LOSSY_2, 0,
    "Keep the total bus below 5m and each branch below 30cm.",
    "Gesamten Bus unter 5m und jede Stichleitung unter 30cm halten.")
UI_TEXT(BF_LOSSY_4, 0,
    "Check that every connector is fully seated.",
    "Prüfe, ob alle Stecker richtig sitzen.")
UI_TEXT(BF_DROPPED_1, 0,
    "The wiring is not the cause. The frames arrived intact.",
    "Die Verkabelung ist nicht die Ursache. Die Frames kamen korrekt an.")
UI_TEXT(BF_DROPPED_2, 0,
    "Frames were not read in time. Please report this fault",
    "Frames wurden nicht rechtzeitig gelesen. Melde diesen Fehler")
UI_TEXT(BF_DROPPED_3, 0,
    "  and include the numbers shown on the right.",
    "  mit den Zahlen auf der rechten Seite.")
UI_TEXT(BF_HEAD_MEANS, 0,
    "WHAT THIS MEANS",
    "WAS DAS BEDEUTET")
UI_TEXT(BF_HEAD_CHECK, 0,
    "CHECK IN THIS ORDER",
    "IN DIESER REIHENFOLGE PRÜFEN")
UI_TEXT(BF_NOTE_1, 0,
    "After acknowledging, the bench stays in simulation.",
    "Nach dem Bestätigen bleibt der Prüfstand in der Simulation.")
UI_TEXT(BF_NOTE_2, 0,
    "It shows simulated values. No outputs are driven.",
    "Die Werte sind simuliert. Kein Ausgang wird angesteuert.")
UI_TEXT(BF_NOTE_LOST, 0,
