UI_TEXT(KP_R_NOT_PROGRAMMING, 116,
    "Port not in programming mode. Tap CONNECT.",
    "Port nicht im Programmiermodus. Tippe auf VERBINDEN.")
UI_TEXT(KP_R_STAGED, 116,
    "Received values were damaged. Nothing was written.",
    "Werte kamen fehlerhaft an. Nichts geschrieben.")
UI_TEXT(KP_R_START, 116,
    "Servo settings changed since the read. Tap READ ALL.",
    "Servowerte haben sich seit dem Auslesen geändert. Tippe auf ALLES AUSLESEN.")
UI_TEXT(KP_R_MUST_READ, 116,
    "Read the servo settings first. Tap READ ALL.",
    "Lies zuerst das Servo aus. Tippe auf ALLES AUSLESEN.")
