UI_TEXT(ED_SAVING, 0,
    "Saving to the card.",
    "Speichere auf die Karte.")
UI_TEXT(ED_SAVED, 0,
    "%s saved.",
    "%s gespeichert.")
UI_TEXT(ED_SAVED_KST, 0,
    "Saved without the checksum line: the servo programmer reads it as edited.",
    "Ohne Prüfsummenzeile gespeichert: der Servo-Programmierer liest sie als bearbeitet.")
UI_TEXT(ED_SAVED_ESC, 0,
    "Saved. The panel reads it at its next start.",
    "Gespeichert. Das Panel liest die Datei beim nächsten Start.")
UI_TEXT(ED_NOT_SAVED_CARD, 0,
    "Not saved: the card was taken out or swapped.",
    "Nicht gespeichert: Die Karte wurde entnommen oder getauscht.")
UI_TEXT(ED_NUL_AHEAD, 0,
    "Not saved: a NUL byte in the first 4kB. FILES would not open the file again.",
    "Nicht gespeichert: ein NUL-Byte in den ersten 4kB. FILES öffnet die Datei nicht wieder.")
UI_TEXT(ED_NO_CHANGES, 0,
    "No changes to save.",
    "Keine Änderungen zu speichern.")
UI_TEXT(ED_FULL, 0,
    "Text full: 1MB at most.",
    "Text voll: höchstens 1MB.")
UI_TEXT(ED_LINES_FULL, 0,
    "Text full: %u lines at most.",
    "Text voll: höchstens %u Zeilen.")
/* The question, under SETUP's UNSAVED CHANGES title, with SETUP's STAY and
 * DISCARD; 2 rows of 54 cells of the 12 x 24 face. */
UI_TEXT(ED_Q_LEAVE, 0,
    "Leave %s without saving? The changes are lost.",
    "%s ohne Speichern verlassen? Die Änderungen gehen verloren.")
UI_TEXT(ED_Q_REVERT, 0,
    "Discard the changes to %s? The text goes back to the file on the card.",
    "Änderungen an %s verwerfen? Der Text wird wieder die Datei auf der Karte.")
UI_TEXT(ED_Q_OPEN, 0,
    "Discard the changes to %s to open another file?",
    "Änderungen an %s verwerfen, um eine andere Datei zu öffnen?")

