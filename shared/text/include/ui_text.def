UI_TEXT(HP_ST_ENTRY_C, 116,
    "Power-up of the servo. Waiting for its answer.",
    "Servo wird eingeschaltet. Warte auf seine Antwort.")
UI_TEXT(HP_ST_ENTRY_D, 116,
    "Servo starting. Frames in 1s.",
    "Servo startet. Daten in 1s.")
UI_TEXT(HP_ST_MODEL, 116,
    "Waiting 1s for the servo on its own supply.",
    "Warte 1s auf das Servo an seiner eigenen Versorgung.")
