UI_TEXT(PG_HELP_DIRECTION, 192,
    "Sets the direction of rotation and whether reverse is allowed.",
    "Legt die Drehrichtung fest und ob Rückwärtslauf erlaubt ist.")
UI_TEXT(PG_HELP_TIMING_STEPS, 192,
    "Sets how early the ESC commutates. Higher timing suits high-kV motors.",
    "Legt fest, wie früh der ESC kommutiert. Höheres Timing passt zu Motoren mit hohem kV.")
UI_TEXT(PG_HELP_PWM, 192,
    "Higher: quieter, but warmer. Lower: more efficient, but audible.",
    "Höher: leiser, aber wärmer. Niedriger: effizienter, aber hörbar.")
UI_TEXT(PG_HELP_STARTUP, 192,
    "Sets the starting power before the ESC can detect the rotor position.",
    "Legt die Anlaufleistung fest, bevor der ESC die Rotorposition erkennt.")
UI_TEXT(PG_HELP_DEMAG, 192,
    "Reduces power if the magnetic field decays too slowly. Helps prevent stalls under load.",
    "Senkt die Leistung, wenn das Magnetfeld zu langsam abklingt. Hilft gegen Blockieren unter Last.")
UI_TEXT(PG_HELP_BRAKE, 192,
    "Holds the motor still at zero throttle instead of letting it spin freely.",
    "Hält den Motor bei null Gas fest, statt ihn frei auslaufen zu lassen.")
UI_TEXT(PG_HELP_LVC, 192,
    "Cell voltage at which power is reduced to protect the battery.",
    "Zellspannung, ab der die Leistung zum Schutz des Akkus gesenkt wird.")
UI_TEXT(PG_HELP_BEEP, 192,
    "Sets the volume of startup tones and the signal-loss beep.",
    "Legt die Lautstärke der Starttöne und des Warntons bei Signalverlust fest.")
UI_TEXT(PG_HELP_TIMING_DEG, 192,
    "Timing in degrees ahead of the rotor. More: higher speed and heat. Less: cooler.",
    "Timing in Grad vor dem Rotor. Mehr: höhere Drehzahl und Wärme. Weniger: kühler.")
UI_TEXT(PG_HELP_SINE, 192,
    "Uses a sine wave at low speed, until the ESC can detect the rotor position.",
    "Nutzt beim Anlauf eine Sinuswelle, bis der ESC die Rotorposition erkennen kann.")
UI_TEXT(PG_HELP_COMPLEMENTARY, 192,
    "Drives both sides of the bridge. Runs cooler, but needs correct timing.",
    "Steuert beide Brückenhälften an. Läuft kühler, braucht aber passendes Timing.")
UI_TEXT(PG_HELP_TELEMETRY, 192,
    "Sends voltage, current and speed back over the signal wire.",
    "Sendet Spannung, Strom und Drehzahl über die Signalleitung zurück.")
UI_TEXT(PG_HELP_MOTOR_TYPE, 192,
    "Selects six-step commutation or field-oriented control.",
    "Wählt Sechsschritt-Kommutierung oder feldorientierte Regelung.")
UI_TEXT(PG_HELP_CURRENT, 192,
    "Limits the current through the motor, regardless of the requested power.",
    "Begrenzt den Motorstrom unabhängig von der angeforderten Leistung.")
UI_TEXT(PG_HELP_REGEN, 192,
    "Feeds braking energy back into the battery instead of the motor.",
    "Leitet Bremsenergie zurück in den Akku statt in den Motor.")
UI_TEXT(PG_TRANSPORT_ONEWIRE, 60,
    "one-wire bootloader, 19200 baud",
    "Eindraht-Bootloader, 19200 Baud")
UI_TEXT(PG_TRANSPORT_CLI, 60,
    "text commands over the signal wire",
    "Textbefehle über die Signalleitung")
UI_TEXT(PG_TRANSPORT_PACKETS, 60,
    "framed data packets, 115200 baud",
    "Datenpakete mit Rahmen, 115200 Baud")
UI_TEXT(PG_DEVICE_BLHELI, 80,
    "BLHeli_S 16.7  on  EFM8BB21",
    "BLHeli_S 16.7  auf  EFM8BB21")
UI_TEXT(PG_DEVICE_AM32, 80,
