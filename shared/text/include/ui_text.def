UI_TEXT(KP_R_NO_SUPPLY, 116,
    "Cannot switch the supply. PD mini is not responding or is off.",
    "Versorgung nicht schaltbar. PD mini antwortet nicht oder ist aus.")
UI_TEXT(KP_R_UNSAFE, 116,
    "The IOmcu refused: its failsafe is latched. Hold ARM, then DISARM, to clear it.",
