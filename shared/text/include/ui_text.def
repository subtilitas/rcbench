UI_TEXT(KP_O_NONE, 116,
    "No result.",
    "Kein Ergebnis.")
UI_TEXT(KP_O_DONE, 116,
    "Done.",
    "Fertig.")
UI_TEXT(KP_O_REFUSED, 116,
    "The IOmcu refused the request.",
    "Der IOmcu hat die Anfrage abgelehnt.")
UI_TEXT(KP_O_NACK, 116,
    "The IOmcu rejected the frame. Reason: %u.",
    "Der IOmcu hat den Frame abgelehnt. Grund: %u.")
UI_TEXT(KP_O_NO_ANSWER, 116,
    "No response from the IOmcu. Tap READ ALL.",
    "Keine Antwort vom IOmcu. ALLES AUSLESEN tippen.")
UI_TEXT(KP_O_RESTARTED, 116,
    "IOmcu restarted. Tap CONNECT, then READ ALL.",
    "IOmcu neu gestartet. VERBINDEN, dann ALLES AUSLESEN tippen.")
UI_TEXT(KP_O_RESTARTED_2, 116,
    "Switch the servo supply off and on first.",
    "Schalte zuerst die Servoversorgung aus und wieder ein.")
UI_TEXT(KP_M_SESSION_ENDED, 116,
    "The port ended the session: power off or restart.",
    "Der Port hat die Sitzung beendet: Versorgung aus oder Neustart.")
UI_TEXT(KP_M_SESSION_ENDED_2, 116,
    "Switch the servo supply off and on, then tap CONNECT.",
    "Servoversorgung aus- und einschalten, dann VERBINDEN tippen.")
UI_TEXT(KP_M_UNKNOWN_CODE, 116,
    "The IOmcu reports code %u. This panel does not recognise it.",
    "IOmcu meldet Code %u. Dieses Panel kennt ihn nicht.")
UI_TEXT(KP_O_DROPPED, 116,
    "Connection lost during the operation. Tap READ ALL.",
    "Verbindung während des Vorgangs verloren. ALLES AUSLESEN tippen.")
UI_TEXT(KP_R_BUSY, 116,
    "Port busy. Try again.",
    "Port belegt. Erneut versuchen.")
UI_TEXT(KP_R_PORT, 116,
    "This programming port does not exist on the IOmcu.",
    "Diesen Programmierport gibt es auf dem IOmcu nicht.")
UI_TEXT(KP_R_NO_PIN, 116,
    "No pin assigned to the programming port. Nothing sent.",
    "Dem Programmierport ist kein Pin zugeordnet. Nichts gesendet.")
UI_TEXT(KP_R_SUPPLY_RANGE, 116,
    "The supply cannot provide this voltage or current limit.",
    "Das Netzteil unterstützt diese Spannung oder Strombegrenzung nicht.")
UI_TEXT(KP_R_LEAVE_MS, 116,
    "Wait before PWM is out of range. Allowed: 0 to 10000ms.",
    "Wartezeit vor PWM außerhalb des Bereichs. Erlaubt: 0 bis 10000ms.")
UI_TEXT(KP_R_SUPPLY_LOW, 116,
    "Supply below 4.8V. Programming requires at least 4.8V.",
    "Versorgung unter 4.8V. Programmieren benötigt mindestens 4.8V.")
UI_TEXT(KP_R_LOCKED, 116,
    "Servo state uncertain. The session stays open. Use RESTORE first.",
    "Servozustand unklar. Sitzung bleibt offen. Zuerst ZURÜCKSPIELEN.")
UI_TEXT(KP_R_NO_SUPPLY, 116,
    "Cannot switch the supply. PD mini is not responding or is off.",
    "Versorgung nicht schaltbar. PD mini antwortet nicht oder ist aus.")
UI_TEXT(KP_R_UNSAFE, 116,
    "The IOmcu refused: its failsafe is latched. Hold ARM, then DISARM, to clear it.",
    "Vom IOmcu abgelehnt: Sein Failsafe ist ausgelöst. ARM halten, dann DISARM, um ihn aufzuheben.")
UI_TEXT(KP_R_NOT_PROGRAMMING, 116,
    "Port not in programming mode. Tap CONNECT.",
    "Port nicht im Programmiermodus. VERBINDEN tippen.")
UI_TEXT(KP_R_STAGED, 116,
    "Received values were damaged. Nothing was written.",
    "Werte kamen fehlerhaft an. Nichts geschrieben.")
UI_TEXT(KP_R_START, 116,
    "Servo settings changed since the read. Tap READ ALL.",
    "Servowerte haben sich seit dem Auslesen geändert. ALLES AUSLESEN tippen.")
UI_TEXT(KP_R_MUST_READ, 116,
    "Read the servo settings first. Tap READ ALL.",
    "Zuerst das Servo auslesen. ALLES AUSLESEN tippen.")
UI_TEXT(KP_R_PLAN_RULES, 116,
    "These values fail the IOmcu's limit checks.",
    "Diese Werte verletzen die Grenzwerte des IOmcu.")
UI_TEXT(KP_R_PLAN_R00, 116,
    "Register 00 differs. It is never written.",
    "Register 00 weicht ab. Es wird nie geschrieben.")
UI_TEXT(KP_R_PLAN_PAIRING, 116,
    "The pairing value differs. Use RELEASE PAIRING.",
    "Der Pairing-Wert weicht ab. PAIRING LÖSEN verwenden.")
UI_TEXT(KP_R_PLAN_NO_PATH, 116,
    "These values cannot be written in a safe order.",
    "Für diese Werte gibt es keine sichere Schreibreihenfolge.")
UI_TEXT(KP_S_BUSY, 116,
    "An operation is running in this session.",
    "In dieser Sitzung läuft ein Vorgang.")
UI_TEXT(KP_S_ARG, 116,
    "This session rejected the request.",
    "Die Anfrage wurde in dieser Sitzung abgelehnt.")
UI_TEXT(KP_S_NO_SERVO, 116,
    "No servo responds. Check the plug, supply and port.",
    "Kein Servo antwortet. Stecker, Versorgung und Port prüfen.")
UI_TEXT(KP_S_NOT_IN_MODE, 116,
    "Servo not in programming mode. Tap LEAVE, then CONNECT.",
    "Servo nicht im Programmiermodus. VERLASSEN, dann VERBINDEN tippen.")
UI_TEXT(KP_S_READ, 116,
    "Could not read the servo. Check the plug, then tap READ ALL.",
    "Servo konnte nicht ausgelesen werden. Stecker prüfen, dann ALLES AUSLESEN tippen.")
UI_TEXT(KP_S_NO_BACKUP, 116,
    "No backup for this session. Tap READ ALL first.",
    "Kein Backup dieser Sitzung. Zuerst ALLES AUSLESEN tippen.")
UI_TEXT(KP_S_LOCKED, 116,
    "Servo state uncertain after a write. Further writes are locked.",
    "Servozustand nach dem Schreiben unklar. Weitere Schreibvorgänge gesperrt.")
UI_TEXT(KP_S_LOCKED_2, 116,
    "Only this session's backup can be restored with RESTORE.",
    "Nur das Backup dieser Sitzung kann mit ZURÜCKSPIELEN wiederhergestellt werden.")
UI_TEXT(KP_S_BAD_PLAN, 116,
    "The write plan was rejected for this session.",
    "Der Schreibplan wurde für diese Sitzung abgelehnt.")
UI_TEXT(KP_S_UNCONFIRMED, 116,
    "Restore was not confirmed.",
    "Zurückspielen wurde nicht bestätigt.")
UI_TEXT(KP_S_CHANGED, 116,
    "Servo settings differ from the values read earlier. Tap READ ALL.",
    "Servowerte weichen von den ausgelesenen Werten ab. ALLES AUSLESEN tippen.")
UI_TEXT(KP_S_WRITE_FAILED, 116,
    "Write failed. No values were left partly written.",
    "Schreiben fehlgeschlagen. Keine Werte sind unvollständig geschrieben.")
UI_TEXT(KP_S_ROLLED_BACK, 116,
    "Write failed. The previous value was restored.",
    "Schreiben fehlgeschlagen. Der vorherige Wert wurde wiederhergestellt.")
UI_TEXT(KP_S_WRITE_PART, 116,
    "Write failed. Earlier writes remain. Tap READ ALL.",
    "Schreiben fehlgeschlagen. Zuvor geschriebene Werte bleiben. ALLES AUSLESEN tippen.")
UI_TEXT(KP_S_TORN, 116,
    "Write failed and could not be undone.",
    "Schreiben fehlgeschlagen. Rückgängig machen war nicht möglich.")
UI_TEXT(KP_S_UNINTENDED, 116,
    "A register changed without being written.",
    "Ein Register hat sich ohne Schreibzugriff geändert.")
UI_TEXT(KP_S_VERIFY, 116,
    "Servo settings do not match the expected values.",
    "Das Servo enthält nicht die erwarteten Werte.")
UI_TEXT(KP_S_DRIVER, 116,
    "Port driver failed. Tap READ ALL.",
    "Porttreiber ausgefallen. ALLES AUSLESEN tippen.")
UI_TEXT(KP_S_ABORTED, 116,
    "Operation aborted. Tap READ ALL.",
    "Vorgang abgebrochen. ALLES AUSLESEN tippen.")
UI_TEXT(KP_S_SUPPLY, 116,
    "The supply did not switch within %ums. Check the supply.",
    "Versorgung hat nicht innerhalb von %ums geschaltet. Versorgung prüfen.")
UI_TEXT(KP_S_TOO_COMPLEX, 116,
    "Too many changes to plan at once. Nothing written.",
    "Zu viele Änderungen für einen gemeinsamen Plan. Nichts geschrieben.")
UI_TEXT(KP_S_TOO_COMPLEX_2, 116,
    "Split the changes. Write fewer values at a time.",
    "Teile die Änderungen auf. Schreibe weniger Werte auf einmal.")
UI_TEXT(KP_H_DUTY_HIGH, 116,
    "Max. duty exceeds its upper limit.",
    "Max. Duty überschreitet die Obergrenze.")
UI_TEXT(KP_H_DUTY_LOW, 116,
    "Max. duty is below its lower limit.",
    "Max. Duty liegt unter der Untergrenze.")
UI_TEXT(KP_H_DUTY_COPY, 116,
    "The two duty registers contain different values.",
    "Die beiden Duty-Register enthalten unterschiedliche Werte.")
UI_TEXT(KP_H_BOOST_HIGH, 116,
    "Boost exceeds its upper limit.",
    "Boost überschreitet die Obergrenze.")
UI_TEXT(KP_H_STRETCH_INDEX, 116,
    "This stretch value has not been confirmed.",
    "Dieser Stretch-Wert ist nicht bestätigt.")
UI_TEXT(KP_H_SPD_HIGH, 116,
    "Speed exceeds its upper limit.",
    "Tempo überschreitet die Obergrenze.")
UI_TEXT(KP_H_SPD_SEL_LOW_SPD, 116,
    "SPEED LIMIT requires SPEED to be above the minimum.",
    "TEMPOGRENZE erfordert ein TEMPO über dem Mindestwert.")
UI_TEXT(KP_H_UNCONT_POS_LOW, 116,
    "Failsafe position is below its lower limit.",
    "Failsafe-Position liegt unter der Untergrenze.")
UI_TEXT(KP_H_UNCONT_POS_HIGH, 116,
    "Failsafe position exceeds its upper limit.",
    "Failsafe-Position überschreitet die Obergrenze.")
UI_TEXT(KP_H_UNCONT_POS_SPAN, 116,
    "Failsafe position must be between Pulse Lower and Pulse Upper.",
    "Failsafe-Position muss zwischen Pulse Lower und Pulse Upper liegen.")
UI_TEXT(KP_H_UNCONT_TIME_LOW, 116,
    "Failsafe delay is below its lower limit.",
    "Failsafe-Zeit liegt unter der Untergrenze.")
UI_TEXT(KP_H_UNCONT_TIME_HIGH, 116,
    "Failsafe delay exceeds its upper limit.",
    "Failsafe-Zeit überschreitet die Obergrenze.")
UI_TEXT(KP_H_LOWER_LOW, 116,
    "Pulse Lower is below its lower limit.",
    "Pulse Lower liegt unter der Untergrenze.")
UI_TEXT(KP_H_LOWER_MARGIN, 116,
    "Pulse Lower is too close to Neutral.",
    "Pulse Lower liegt zu nah an Neutral.")
UI_TEXT(KP_H_UPPER_HIGH, 116,
    "Pulse Upper exceeds its upper limit.",
    "Pulse Upper überschreitet die Obergrenze.")
UI_TEXT(KP_H_UPPER_MARGIN, 116,
    "Pulse Upper is too close to Neutral.",
    "Pulse Upper liegt zu nah an Neutral.")
UI_TEXT(KP_H_SPAN, 116,
    "Pulse Lower and Pulse Upper are too close together.",
    "Pulse Lower und Pulse Upper liegen zu nah beieinander.")
UI_TEXT(KP_H_NEUTRAL_LOW, 116,
    "Neutral is below its lower limit.",
    "Neutral liegt unter der Untergrenze.")
UI_TEXT(KP_H_NEUTRAL_HIGH, 116,
    "Neutral exceeds its upper limit.",
    "Neutral überschreitet die Obergrenze.")
UI_TEXT(KP_H_LEFT_ZERO, 116,
    "Left Angle must not be 0.",
    "Left Angle darf nicht 0 sein.")
UI_TEXT(KP_H_RIGHT_ZERO, 116,
    "Right Angle must not be 0.",
    "Right Angle darf nicht 0 sein.")
UI_TEXT(KP_H_GYRO_MODE, 116,
    "Gyro mode limits are unknown. Writing is blocked.",
    "Grenzen im Gyro-Modus unbekannt. Schreiben ist gesperrt.")
UI_TEXT(KP_H_LOCKED, 116,
    "A locked value differs. It will not be written.",
    "Ein gesperrter Wert weicht ab. Er wird nicht geschrieben.")
UI_TEXT(KP_H_NEVER, 116,
    "A value that is never written differs.",
    "Ein Wert, der nie geschrieben wird, weicht ab.")
UI_TEXT(KP_W_DUTY_RAISED, 116,
    "Higher duty increases stall current and heat.",
    "Höheres Duty erhöht den Blockierstrom und die Erwärmung.")
UI_TEXT(KP_W_DUTY_BELOW_HALF, 116,
    "Low duty weakens the servo. It may not hold the control surface.",
    "Niedriges Duty schwächt das Servo. Es hält das Ruder möglicherweise nicht.")
UI_TEXT(KP_W_BOOST_RAISED, 116,
    "Higher boost can cause buzzing and heat.",
    "Mehr Boost kann das Servo brummen und heiß werden lassen.")
UI_TEXT(KP_W_STRETCH_RAISED, 116,
    "Higher stretch can cause servo oscillation.",
    "Mehr Stretch kann das Servo zum Schwingen bringen.")
UI_TEXT(KP_W_SOFT_START_OFF, 116,
    "Without soft start, the servo moves abruptly at power-on.",
    "Ohne Soft Start bewegt sich das Servo beim Einschalten ruckartig.")
UI_TEXT(KP_W_SPD_SEL_ON, 116,
    "Speed limit active. The servo moves at the set speed.",
    "Tempogrenze aktiv. Das Servo bewegt sich mit dem eingestellten Tempo.")
UI_TEXT(KP_W_SPD_SLOW, 116,
    "A slow servo can cause loss of control of the model.",
    "Ein zu langsames Servo kann zum Kontrollverlust über das Modell führen.")
UI_TEXT(KP_W_DEAD_BAND_NARROWED, 116,
    "A narrow dead band can cause back-and-forth movement and heat.",
    "Ein schmales Dead Band kann Pendeln und Erwärmung verursachen.")
UI_TEXT(KP_W_DEAD_BAND_BELOW_1US, 116,
    "Very narrow dead band. Back-and-forth movement and heat are likely.",
    "Sehr schmales Dead Band. Pendeln und Erwärmung sind wahrscheinlich.")
UI_TEXT(KP_W_ALLOW_UNCONT_ON, 116,
    "On signal loss the servo moves to the failsafe position.",
    "Ohne Signal fährt das Servo auf die Failsafe-Position.")
UI_TEXT(KP_W_UNCONT_POS_FAR, 116,
    "Failsafe position is far from the centre.",
    "Die Failsafe-Position liegt weit von der Mitte entfernt.")
UI_TEXT(KP_W_UNCONT_TIME_SHORT, 116,
    "Short dropouts will trigger the failsafe move.",
    "Kurze Aussetzer lösen die Failsafe-Bewegung aus.")
UI_TEXT(KP_W_END_NEAR, 116,
    "End point close to Neutral. Little travel remains on this side.",
    "Endpunkt nah an Neutral. Auf dieser Seite bleibt wenig Weg.")
UI_TEXT(KP_W_END_MOVED, 116,
    "End point changed. The servo travel per stick movement changes too.",
    "Endpunkt geändert. Dadurch ändert sich auch der Servoweg je Knüppelbewegung.")
UI_TEXT(KP_W_NEUTRAL_MOVED, 116,
    "The centre shifts. One side moves closer to the mechanical stop.",
    "Die Mitte verschiebt sich. Eine Seite kommt näher an den mechanischen Anschlag.")
UI_TEXT(KP_W_REVERSION_CHANGED, 116,
    "Direction reversed. Check all control surfaces before flight.",
    "Drehrichtung umgekehrt. Prüfe vor dem Flug alle Ruder.")
UI_TEXT(KP_W_ANGLE_RAISED, 116,
    "More travel can push the servo against its stop and burn it out.",
    "Mehr Weg kann das Servo gegen den Anschlag fahren und durchbrennen lassen.")
UI_TEXT(KP_W_ANGLE_SMALL, 116,
    "Small angle. Full stick movement gives little servo travel.",
    "Kleiner Winkel. Voller Knüppelweg ergibt nur wenig Servoweg.")
UI_TEXT(KP_W_GYRO_CHANGED, 116,
    "Pulse standard changed. The wrong standard drives the servo into its stop.",
    "Pulsstandard geändert. Ein falscher Standard fährt das Servo in den Anschlag.")
UI_TEXT(KP_W_NARROW_BAND_GAIN, 116,
    "Narrow dead band and higher gain can cause oscillation.",
    "Schmales Dead Band und mehr Gain können Schwingungen verursachen.")
UI_TEXT(KP_W_HIGH_DUTY_TRAVEL, 116,
    "High duty and more travel: a stall can destroy the servo.",
    "Hohes Duty und mehr Weg: Blockieren kann das Servo zerstören.")
